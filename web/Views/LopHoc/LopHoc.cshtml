@{
    ViewData["Title"] = "Bắt đầu buổi học OFFLINE";
}

<style>

    .start-lesson-wrap {
        max-width: 980px;
        margin: auto
    }

    .start-lesson-card {
        border: 1px solid #dbeafe;
        background: linear-gradient(180deg,#eff6ff,#fff);
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 16px
    }

    .lesson-box {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 16px;
        background: #fff
    }

    .lesson-info {
        margin-top: 10px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px
    }

    .info-item {
        background: #f8fafc;
        padding: 10px;
        border-radius: 10px
    }

    .lesson-check {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: 10px;
        margin-top: 10px
    }

    .camera-zone {
        margin-top: 15px
    }

    .camera-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px
    }

    .cam-box {
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 10px
    }

    .cam-view {
        width: 100%;
        min-height: 220px;
        background: #0f172a;
        border-radius: 10px;
        object-fit: cover
    }

    .timer-box {
        margin-top: 14px;
        background: #f1f5f9;
        padding: 12px;
        border-radius: 10px;
        text-align: center;
        font-weight: 700;
        font-size: 20px
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px
    }

    .dot-ok {
        background: #16a34a
    }

    .dot-warn {
        background: #f59e0b
    }

</style>

<div class="start-lesson-wrap">

    <div class="d-flex justify-content-between mb-3">
        <h3>Bắt đầu buổi học OFFLINE</h3>
        <a href="/LopHoc/thongbaolich" class="btn btn-outline-secondary">← Quay lại</a>
    </div>

    <div class="start-lesson-card">

        <div class="fw-bold">Luồng buổi học</div>

        <div class="text-muted">
            1. Điểm danh → 2. Mở camera → 3. Chụp ảnh → 4. Bắt đầu buổi học
        </div>

    </div>

    <div class="lesson-box">

        <div class="fw-bold lesson-title">Đang tải thông tin lớp...</div>

        <div class="lesson-info">

            <div class="info-item">
                <div class="text-muted">Giờ bắt đầu</div>
                <div id="scheduledStart" class="fw-semibold"></div>
            </div>

            <div class="info-item">
                <div class="text-muted">Giờ kết thúc</div>
                <div id="scheduledEnd" class="fw-semibold"></div>
            </div>

            <div class="info-item">
                <div class="text-muted">Email gia sư</div>
                <div id="alertEmail" class="fw-semibold"></div>
            </div>

        </div>

        <div class="lesson-check">
            <span>Điểm danh</span>
            <span id="statusAttendance">
                <span class="status-dot dot-warn"></span>Chưa xác nhận
            </span>
        </div>

        <div class="lesson-check">
            <span>Ảnh xác nhận</span>
            <span id="statusCapture">
                <span class="status-dot dot-warn"></span>Chưa chụp
            </span>
        </div>

        <div class="camera-zone">

            <div class="camera-grid">

                <div class="cam-box">

                    <div class="fw-semibold mb-2">Camera học viên</div>

                    <video id="camPreview" autoplay playsinline class="cam-view"></video>

                    <div class="mt-2">

                        <button id="btnOpenCam" class="btn btn-outline-primary">
                            Mở camera
                        </button>

                        <button id="btnCapture" class="btn btn-outline-dark">
                            Chụp ảnh
                        </button>

                    </div>

                </div>

                <div class="cam-box">

                    <div class="fw-semibold mb-2">Ảnh xác nhận</div>

                    <img id="capturedImage" class="cam-view" />

                    <canvas id="captureCanvas" style="display:none"></canvas>

                </div>

            </div>

        </div>

        <div class="timer-box" id="timerBox">
            00:00:00
        </div>

        <div class="mt-3 text-end">

            <button id="btnStartLesson" class="btn btn-primary">
                Bắt đầu buổi học
            </button>

            <button id="btnStopLesson" class="btn btn-outline-secondary">
                Kết thúc
            </button>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        var idlop=@ViewBag.Id
        var iddk=@ViewBag.iddk
        var idbuoihoc=0

        let streamRef=null
        let capturedOk=false
        let lessonStartedAt=null
        let timerRef=null
        let hasStartedLesson=false

        $(function(){

            $("#btnStopLesson").hide()

            loadThongTinBuoiHoc()

        })

        function loadThongTinBuoiHoc(){

            $.ajax({

                url:'/LopHoc/GetThongTinBuoiHoc',
                type:'GET',
                data:{idlop:idlop,iddk:iddk},

                success:function(res){
                    console.log(res)
                    if(!res.success) return

                    let item=res.data[0]

                    $(".lesson-title").html(
                        item.mon + " lớp " + item.trinhdo +
                        " - Gia sư " + item.giasu +
                        "<br>Học viên: " + item.name
                    )

                    $("#alertEmail").text(item.email_Giasu)

                    let start=item.gioBatDau.substring(0,5)
                    let end=item.gioKetThuc.substring(0,5)

                    $("#scheduledStart").text(start)
                    $("#scheduledEnd").text(end)


                    // kiểm tra buổi học
                    if(item.buoiHocID == null || item.buoiHocID == 0){

                        $("#btnStopLesson").hide()

                    }else{
                        idbuoihoc=item.buoiHocID
                        loadTrangThaiBuoiHoc(item.buoiHocID)

                    }

                }

            })

        }

                function loadTrangThaiBuoiHoc(buoiHocID){

            $.ajax({

                url:'/LopHoc/GetTrangThaiBuoiHoc',
                type:'GET',
                data:{buoiHocID:buoiHocID},

                success:function(res){
                    console.log(res)

                    if(!res.success) return

                    $("#btnStopLesson").hide()
                    $("#btnStartLesson").hide()
                    $("#btnCapture").hide()
                    $("#btnOpenCam").hide()

                    if(res.data.trangThai==1){
                        hasStartedLesson = true
                        idbuoihoc=res.data.id
                        $("#btnStopLesson").show()
                        // lấy giờ bắt đầu từ server
                             let time = res.data.gioBatDau.split('.')[0]   // bỏ mili giây

        let today = new Date().toISOString().split('T')[0]

        lessonStartedAt = new Date(today + "T" + time)

        console.log(lessonStartedAt)

                        // tính thời gian đã trôi
                        function updateTimer(){

                            let diff=Math.floor((Date.now()-lessonStartedAt.getTime())/1000)

                            let h=String(Math.floor(diff/3600)).padStart(2,'0')
                            let m=String(Math.floor((diff%3600)/60)).padStart(2,'0')
                            let s=String(diff%60).padStart(2,'0')

                            $("#timerBox").text(h+":"+m+":"+s)

                        }

                        updateTimer()

                        timerRef=setInterval(updateTimer,1000)

                    }

                }

            })

        }

        $("#btnOpenCam").click(async function(){

            streamRef=await navigator.mediaDevices.getUserMedia({video:true})

            $("#camPreview")[0].srcObject=streamRef

            $("#statusAttendance").html('<span class="status-dot dot-ok"></span>Đã xác nhận')

        })

               $("#btnCapture").click(function(){

            let video = $("#camPreview")[0]
            let canvas = $("#captureCanvas")[0]

            canvas.width = video.videoWidth
            canvas.height = video.videoHeight

            canvas.getContext("2d").drawImage(video,0,0)

            let data = canvas.toDataURL()

            $("#capturedImage").attr("src",data)

            capturedOk = true

            $("#statusCapture").html('<span class="status-dot dot-ok"></span>Đã chụp')

            // TẮT CAMERA
            if(streamRef){
                streamRef.getTracks().forEach(track => track.stop())
                $("#camPreview")[0].srcObject = null
            }

        })

        $("#btnStartLesson").click(function(){

            if(!capturedOk){
                Swal.fire("Thiếu xác nhận","Cần chụp ảnh trước khi bắt đầu","warning")
                return
            }

            $.ajax({

                url:'/LopHoc/StartLesson',
                type:'POST',
                data:{
                    idlop:idlop
                },

                success:function(res){

                    if(!res.success){
                        Swal.fire("Không thể bắt đầu buổi học",res.message || "Có lỗi xảy ra","error")
                        return
                    }

                    $("#btnStopLesson").show()
                    hasStartedLesson = true
                    idbuoihoc = Number(res.success) || 0

                    lessonStartedAt=new Date()

                    timerRef=setInterval(function(){

                        let diff=Math.floor((Date.now()-lessonStartedAt.getTime())/1000)

                        let h=String(Math.floor(diff/3600)).padStart(2,'0')
                        let m=String(Math.floor(diff%3600/60)).padStart(2,'0')
                        let s=String(diff%60).padStart(2,'0')

                        $("#timerBox").text(h+":"+m+":"+s)

                    },1000)

                    Swal.fire("Đã bắt đầu buổi học","","success")

                }

            })

        })

               $("#btnStopLesson").click(function(){

            clearInterval(timerRef)

            $.ajax({

                url:'/LopHoc/StopLesson',
                type:'POST',
                data:{
                    ID:idbuoihoc
                },

                success:function(res){

                    if(res.success){

                        hasStartedLesson = false
                        $("#timerBox").text("00:00:00")

                        Swal.fire({
                            title:"Đã kết thúc buổi học",
                            icon:"success"
                        }).then(()=>{
                            window.location.href="/LopHoc/ThongBaoLich"
                        })

                    }else{

                        Swal.fire("Lỗi",res.message,"error")

                    }

                }

            })

        })


    </script>

}