@{
    ViewData["Title"] = "Chi tiết lịch học";
    var lopHocId = ViewBag.LopHocId ?? 0;
}

<style>
    .detail-wrap { max-width: 1000px; margin: auto; }
    .detail-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 20px; margin-bottom: 20px; }
    .detail-title { font-weight: 700; font-size: 1.2rem; margin-bottom: 10px; }
    .schedule-list { margin-top: 10px; }
    .schedule-item { padding: 10px; border-bottom: 1px dashed #ddd; font-size: .95rem; }
    .empty-schedule { color: #6b7280; font-style: italic; }
</style>

<div class="detail-wrap">
    <h2 class="mb-4">Chi tiết lịch học</h2>

    <div class="detail-card">
        <div class="detail-title">Thông tin lớp học (tĩnh)</div>
        <p><b>Mã lớp:</b> #@lopHocId</p>
        <p><b>Môn học:</b> Toán 9</p>
        <p><b>Gia sư:</b> Nguyễn Văn A</p>
        <p><b>Trạng thái:</b> Đang dạy</p>
    </div>

    <div class="detail-card">
        <div class="detail-title">Lịch học trong tuần</div>
        <div id="scheduleList" class="schedule-list">
            <div class="empty-schedule">Đang tải lịch học...</div>
        </div>
    </div>

    <div class="detail-card">
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-success">Chấp nhận</button>
            <button type="button" class="btn btn-warning text-white">Điều chỉnh</button>
            <button type="button" class="btn btn-danger">Hủy</button>
            <a href="/LopHoc/Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        const lopHocId = @lopHocId;

        $.ajax({
            url: '/LopHoc/LopHoc_Buoihocdangki_GetList_ByIDLopHoc',
            type: 'GET',
            data: { id: lopHocId },
            success: function (res) {
                if (!res.success) {
                    $('#scheduleList').html(`<div class="empty-schedule">${res.message || 'Không tải được lịch học.'}</div>`);
                    return;
                }

                renderSchedule(res.data || []);
            },
            error: function () {
                $('#scheduleList').html('<div class="empty-schedule">Lỗi gọi dữ liệu lịch học.</div>');
            }
        });

        function renderSchedule(data) {
            if (!data.length) {
                $('#scheduleList').html('<div class="empty-schedule">Chưa có buổi học đăng ký cho lớp này.</div>');
                return;
            }

            const html = data.map(item => `
                <div class="schedule-item">
                    Thứ ${item.thu} • ${formatTime(item.giobatdau)} - ${formatTime(item.gioketthuc)}
                </div>
            `).join('');

            $('#scheduleList').html(html);
        }

        function formatTime(timeString) {
            if (!timeString) return '';
            return timeString.substring(0, 5);
        }
    });
</script>
}
