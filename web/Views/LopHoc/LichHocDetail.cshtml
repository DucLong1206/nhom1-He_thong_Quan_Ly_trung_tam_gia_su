@{
    ViewData["Title"] = "Chi tiết lịch học";
    var lopHocId = ViewBag.LopHocId ?? 0;
}

<style>
    .detail-wrap {
        max-width: 1000px;
        margin: auto
    }

    .detail-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px
    }

    .detail-title {
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 10px
    }

    .schedule-list {
        margin-top: 10px
    }

    .schedule-item {
        padding: 10px;
        border-bottom: 1px dashed #ddd;
        font-size: .95rem
    }

    .empty-schedule {
        color: #6b7280;
        font-style: italic
    }

    .refund-note {
        border: 1px dashed #f59e0b;
        border-radius: 12px;
        padding: 12px;
        background: #fffbeb;
        margin-bottom: 12px;
    }

    .edit-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr auto;
        gap: 10px;
        margin-bottom: 8px
    }


    @@media(max-width:768px) {
        .edit-row {
            grid-template-columns: 1fr
        }
    }
</style>

<div class="detail-wrap">

    <h2 class="mb-4">Chi tiết lịch học</h2>

    <div class="detail-card">
        <div class="detail-title">Thông tin lớp học</div>

        <p><b>Mã lớp:</b> #@lopHocId</p>
        <p><b>Môn học:</b> <span id="monHoc">Đang tải...</span></p>
        <p><b>Gia sư:</b> <span id="giaSu">Đang tải...</span></p>
        <p><b>Trình độ:</b> lớp <span id="trinhDo">...</span></p>
        <p><b>Học phí / buổi:</b> <span id="hocPhi">...</span></p>
        <p><b>Trạng thái:</b> <span id="trangThai">...</span></p>

    </div>


    <div class="detail-card">
        <div class="detail-title">Lịch học trong tuần</div>

        <div id="scheduleList" class="schedule-list">
            <div class="empty-schedule">Đang tải lịch học...</div>
        </div>

    </div>


    <div class="detail-card" id="editBox" style="display:none">

        <div class="detail-title">Điều chỉnh lịch học</div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Địa chỉ / Xã</label>
            <input id="diaChiInput" type="text" class="form-control" />
        </div>

        <div id="editRows"></div>


        <div class="d-flex gap-2 flex-wrap mt-2">
            <button type="button" id="btnAddRow" class="btn btn-outline-primary">+ Thêm buổi</button>
            <button type="button" id="btnSubmitChange" class="btn btn-primary">Thay đổi</button>
            <button type="button" id="btnCancelEdit" class="btn btn-light border">Hủy chỉnh sửa</button>
        </div>

    </div>


    <div class="detail-card">

        <div class="refund-note">
            <div class="fw-bold mb-1">Hoàn phí lớp hỏng (2 buổi đầu)</div>
            <div id="refundStatus">Đang kiểm tra điều kiện hoàn phí...</div>
            <small class="text-muted">Rule: 0-1 buổi hoàn 100%, 2 buổi hoàn 50%, quá 2 buổi không hoàn theo chính sách này.</small>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <button type="button" id="btnDongY" class="btn btn-success">Chấp nhận</button>
            <button type="button" id="btnShowEdit" class="btn btn-warning text-white">Điều chỉnh</button>
            <button type="button" id="btnHuy" class="btn btn-danger">Hủy</button>
            <button type="button" id="btnHoanPhi" class="btn btn-outline-danger">Yêu cầu hoàn phí</button>
            <a href="/LopHoc/DoiNgayHoc?lopId=@lopHocId&nguon=phu-huynh" class="btn btn-outline-warning">Điều chỉnh ngày học sang ngày khác</a>
            <a href="/LopHoc/DoiNgayHoc?lopId=@lopHocId&nguon=phu-huynh" id="btndieuchinh" class="btn btn-outline-warning">Điều chỉnh ngày học sang ngày khác</a>

            <a href="/LopHoc/Index" class="btn btn-secondary">Quay lại</a>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        $(document).ready(function(){

        const lopHocId=@lopHocId;
        let currentSchedule=[];

        loadLopHocInfo();
        loadLichHoc();
        loadRefundEligibility();



        function loadLopHocInfo(){

        $.ajax({

        url:'/LopHoc/getlopbyid',
        type:'GET',
        data:{id:lopHocId},

        success:function(res){

        if(!res.success)return;

        const d=res.data;
        console.log(d)

        $('#monHoc').text(d.mon);
        $('#giaSu').text(d.name);
        $('#trinhDo').text(d.trinhdo);
        $('#hocPhi').text(d.sotienMotBuoi+" đ");
        $('#trangThai').text(d.trangthai);
        if(d.trangthai === "Điều chỉnh"){
                $('#btnDongY').show();
                $('#btnShowEdit').show();
            }else{
                $('#btnDongY').hide();
                $('#btnShowEdit').hide();
            }
        if(d.trangthai === "Hủy"){
              $('#btndieuchinh').hide();
              $('#btnHuy').hide();
         }
        }
        

        })

        }



        function loadLichHoc(){

        $.ajax({

        url:'/LopHoc/LopHoc_Buoihocdangki_GetList_ByIDLopHoc',
        type:'GET',
        data:{id:lopHocId},

        success:function(res){

        if(!res.success){

        $('#scheduleList').html('<div class="empty-schedule">Không tải được lịch học</div>');
        return;

        }

        currentSchedule=res.data||[];
        renderSchedule(currentSchedule);

        }

        })

        }



        function renderSchedule(data){

        if(!data.length){

        $('#scheduleList').html('<div class="empty-schedule">Chưa có buổi học</div>');
        return;

        }

        const html=data.map(x=>`

        <div class="schedule-item">

        ${formatThu(x.thu)} • ${formatTime(x.giobatdau)} - ${formatTime(x.gioketthuc)}

        </div>

        `).join('');

        $('#scheduleList').html(html);

        }



        function addEditRow(thu=2,start='18:00',end='19:30'){

        const row=`

        <div class="edit-row">

        <select class="form-select edit-thu">

        ${[2,3,4,5,6,7,8].map(x=>`<option value="${x}" ${x==thu?'selected':''}>${x==8?'Chủ nhật':'Thứ '+x}</option>`).join('')}

        </select>

        <input type="time" class="form-control edit-start" value="${start}">

        <input type="time" class="form-control edit-end" value="${end}">

        <button type="button" class="btn btn-outline-danger btn-remove-row">Xóa</button>

        </div>

        `;

        $('#editRows').append(row);

        }



        $('#btnShowEdit').click(function(){

        $('#editRows').empty();

        if(currentSchedule.length){

        currentSchedule.forEach(x=>addEditRow(x.thu,x.giobatdau,x.gioketthuc));

        }else{

        addEditRow();

        }

        $('#editBox').slideDown();

        });



        $('#btnAddRow').click(()=>addEditRow());



        $(document).on('click','.btn-remove-row',function(){

        $(this).closest('.edit-row').remove();

        });



        $('#btnCancelEdit').click(()=>$('#editBox').slideUp());

        $('#btnSubmitChange').click(function(){

        const dsBuoi=[];

        $('#editRows .edit-row').each(function(){

        const thu=$(this).find('.edit-thu').val();
        const start=$(this).find('.edit-start').val();
        const end=$(this).find('.edit-end').val();

        if(thu&&start&&end){

        dsBuoi.push({

        IDlophoc:lopHocId,
        thu:parseInt(thu),
        giobatdau:start+":00",
        gioketthuc:end+":00"

        })

        }

        });

        if(!dsBuoi.length){

        alert("Vui lòng nhập ít nhất 1 buổi học");
        return;

        }

        const payload={

        lopid:lopHocId,
        loai:"dieuchinhph",
        diaChi:$('#diaChiInput').val(),
        dsBuoi:dsBuoi

        };

        sendPhanHoi(payload);

        });



        $('#btnDongY').click(function(){

        if(!confirm("Bạn chắc chắn muốn chấp nhận lớp này?"))return;

        sendPhanHoi({lopid:lopHocId,loai:"dongy"});

        });



        $('#btnHuy').click(function(){

        if(!confirm("Bạn chắc chắn muốn hủy lớp này?"))return;

        sendPhanHoi({lopid:lopHocId,loai:"huy"});

        });

        $('#btnHoanPhi').click(function(){

        if($(this).prop('disabled')) return;

        if(!confirm("Xác nhận gửi yêu cầu hoàn phí cho lớp này?")) return;

        $.ajax({

        url:'/LopHoc/XuLyHoanPhiKhiLopHong2BuoiDau',
        type:'POST',
        data:{lopId:lopHocId},

        success:function(res){

        if(!res.success){

        alert(res.message||"Không thể xử lý hoàn phí.");
        loadRefundEligibility();
        return;

        }

        alert((res.message || "Đã xử lý hoàn phí") + "\nSố tiền hoàn: " + Number(res.soTienHoan || 0).toLocaleString('vi-VN') + " VNĐ");
        loadRefundEligibility();

        }

        })

        });

        function loadRefundEligibility(){

        $.ajax({

        url:'/LopHoc/KiemTraDieuKienHoanPhi',
        type:'GET',
        data:{lopId:lopHocId},

        success:function(res){

        if(!res.success || !res.data){
            $('#refundStatus').text(res.message || 'Không kiểm tra được điều kiện hoàn phí.');
            $('#btnHoanPhi').prop('disabled', true).text('Yêu cầu hoàn phí');
            return;
        }

        const d = res.data;
        const msg = `${d.message} (Đã học: ${d.soBuoiDaHoc} buổi)`;
        $('#refundStatus').text(msg);

        if(d.coTheHoanPhi){
            $('#btnHoanPhi').prop('disabled', false).removeClass('btn-secondary').addClass('btn-outline-danger').text('Yêu cầu hoàn phí');
        }else{
            $('#btnHoanPhi').prop('disabled', true).removeClass('btn-outline-danger').addClass('btn-secondary').text('Không đủ điều kiện hoàn phí');
        }

        }

        })

        }



        function sendPhanHoi(payload){

        $.ajax({

        url:'/LopHoc/XuLyPhanHoi',
        type:'POST',
        contentType:'application/json',
        data:JSON.stringify(payload),

        success:function(res){

        if(!res.success){

        alert(res.message);
        return;

        }

        alert(res.message||"Thành công");
        location.reload();

        }

        })

        }



        function formatThu(thu){

        return Number(thu)==8?"Chủ nhật":"Thứ "+thu;

        }



        function formatTime(t){

        if(!t)return'';

        return String(t).substring(0,5);

        }

        });

    </script>

}
