@{
    ViewData["Title"] = "Thông báo lịch học";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Thông báo lịch học</h4>
        <span class="badge bg-primary-subtle text-primary-emphasis">Lịch dạy</span>
    </div>

    <ul class="nav nav-tabs">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#homnay">
                Hôm nay
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#ngaymai">
                Ngày mai
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#homqua">
                Hôm qua
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3">

        <!-- HÔM NAY -->
        <div class="tab-pane fade show active" id="homnay">
            <div class="list-group" id="listlichhomnay">
                <div class="text-center text-muted">
                    Đang tải lịch học...
                </div>
            </div>
        </div>

        <!-- NGÀY MAI -->
        <div class="tab-pane fade" id="ngaymai">
            <div class="list-group">
                <div class="list-group-item">
                    <div class="fw-semibold">09:00 - Lớp Vật lý 10</div>
                    <small class="text-muted">Giáo viên: Nguyễn Văn A</small>
                </div>

                <div class="list-group-item">
                    <div class="fw-semibold">19:30 - Lớp Hóa 11</div>
                    <small class="text-muted">Giáo viên: Trần Thị B</small>
                </div>
            </div>
        </div>

        <!-- HÔM QUA -->
        <div class="tab-pane fade" id="homqua">
            <div class="list-group">
                <div class="list-group-item">
                    <div class="fw-semibold">07:30 - Lớp Văn 12</div>
                    <small class="text-muted">Đã hoàn thành</small>
                </div>

                <div class="list-group-item">
                    <div class="fw-semibold">16:00 - Lớp Sinh học 8</div>
                    <small class="text-muted">Đã hoàn thành</small>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts{

    <script>

        $(document).ready(function () {

            loadLichHomNay();

        });


        function loadLichHomNay() {

            $.ajax({

                url: '@Url.Action("getlichhomnay", "Lophoc")',
                type: 'GET',

                success: function (data) {

                    let html = '';

                    if (!data || data.length === 0) {

                        html = `<div class="list-group-item text-muted">
                                    Hôm nay không có lịch học
                                </div>`;
                    }

                    else {

                        data.forEach(function (item) {

                            html += `
                                <a href="@Url.Action("lophoc", "LopHoc")"
                                   class="list-group-item list-group-item-action">

                                    <div class="fw-semibold">
                                        ${item.gioBatDau} - ${item.gioKetThuc}
                                        | ${item.mon} ${item.trinhdo}
                                    </div>

                                    <small class="text-muted">
                                        Người tạo lớp: ${item.name}
                                    </small>

                                </a>
                            `;
                        });
                    }

                    $("#listlichhomnay").html(html);
                },

                error: function () {

                    $("#listlichhomnay").html(`
                        <div class="list-group-item text-danger">
                            Không tải được dữ liệu lịch học
                        </div>
                    `);
                }

            });

        }

    </script>
}