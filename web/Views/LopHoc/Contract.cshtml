@{
    ViewData["Title"] = "Hợp đồng nhận lớp gia sư";
    var ds = ViewBag.ds;
    var data = ViewBag.data;
}

<div class="container py-4">

    <div class="card shadow-lg border-0">
        <div class="card-body p-5">

            <h3 class="text-center mb-4">HỢP ĐỒNG NHẬN LỚP GIA SƯ</h3>

            <p class="text-center">
                (Áp dụng cho lớp học ID: <b>@ds.IDLopHoc</b>)
            </p>

            <hr />

            <h5>1. Thông tin các bên</h5>

            <p>
                <b>Bên A:</b> Trung tâm gia sư
            </p>

            <p>
                <b>Bên B:</b> Gia sư nhận lớp:@data.nguoiGui?.Name 
            </p>

           

            <hr />

            <h5>2. Thông tin lớp học</h5>

            <ul>
                <li><b>Môn học:</b> @data.tenmon</li>
                <li><b>Trình độ học sinh:</b> lớp @data.lop.trinhdo</li>
                <li><b>Số buổi học mỗi tuần:</b> @(data.dsBuoi?.Count ?? 0) buổi</li>
                <li><b>Địa điểm học:</b> @data.lop?.DIaChi</li>
                <li><b>Thời gian học:</b> Theo lịch học đã được xác nhận.</li>
            </ul>

            <hr />

            <h5>3. Cam kết thực hiện</h5>

            <ul>
                <li>Gia sư cam kết dạy đúng lịch học đã đăng ký.</li>
                <li>Số buổi thực hiện sẽ được ghi nhận theo lịch học thực tế.</li>
                <li>Gia sư phải đảm bảo chất lượng giảng dạy và thái độ chuyên nghiệp.</li>
            </ul>

            <hr />

            <h5>4. Quy định nghỉ học và dạy bù</h5>

            <ul>
                <li>Nếu gia sư bận, phải báo trước ít nhất <b>24 giờ</b>.</li>
                <li>Nếu học viên nghỉ học phải báo trước cho gia sư hoặc trung tâm.</li>
                <li>Các buổi nghỉ sẽ được sắp xếp dạy bù theo thỏa thuận của hai bên.</li>
            </ul>

            <hr />

            <h5>5. Quyền và nghĩa vụ của gia sư</h5>

            <ul>
                <li>Đến lớp đúng giờ và chuẩn bị bài giảng đầy đủ.</li>
                <li>Không tự ý thay đổi lịch học khi chưa có sự đồng ý của phụ huynh hoặc trung tâm.</li>
                <li>Giữ thái độ lịch sự và tôn trọng học sinh.</li>
                <li>Thông báo cho trung tâm nếu có vấn đề phát sinh trong quá trình dạy học.</li>
            </ul>

            <hr />

            <h5>6. Quyền và nghĩa vụ của trung tâm</h5>

            <ul>
                <li>Cung cấp thông tin lớp học chính xác.</li>
                <li>Hỗ trợ gia sư khi có vấn đề phát sinh với phụ huynh hoặc học sinh.</li>
            </ul>

            <hr />

            <h5>7. Điều khoản chung</h5>

            <p>
                Hai bên cam kết thực hiện đúng các điều khoản đã nêu trong hợp đồng này.
                Hợp đồng có hiệu lực kể từ khi gia sư xác nhận nhận lớp và kéo dài trong suốt
                quá trình giảng dạy lớp học.
            </p>

            <hr />

            <div class="row mt-5 text-center">

                <div class="col-md-6">
                    <p><b>BÊN A</b></p>
                    <p>(Trung tâm gia sư)</p>
                    <p><b>Long</b></p>
                   <br />
                    <p><b>Phạm Đức Long</b></p>
                </div>

                <div class="col-md-6">
                    <p><b>BÊN B</b></p>
                    <p>(Gia sư nhận lớp)</p>
                    <br />
                    <br /><br />
                    <p>..............................</p>
                </div>

            </div>

            <hr class="mt-5" />

            <div class="text-center">

                <button id="btnDongYHopDong" class="btn btn-success me-2">
                    ✔ Tôi đồng ý hợp đồng
                </button>

                <a href="/LopHoc/Detail/@ds.IDLopHoc"
                   class="btn btn-outline-secondary">
                    ⬅ Quay lại
                </a>

            </div>

        </div>
    </div>

</div>
@section Scripts {

    <script>

        const lopId = @ds.IDLopHoc;

        $("#btnDongYHopDong").click(function () {

            if (!confirm("Bạn xác nhận đồng ý hợp đồng này?"))
                return;

            $.ajax({
                url: "/LopHoc/changhopdong",
                type: "POST",
                data: {
                    id: lopId,
                    trangthai: 2
                },
                success: function (res) {

                    if (res.success) {

                        alert("Đồng ý hợp đồng thành công");

                        window.location.href = "/LopHoc/Detail/" + lopId;

                    }
                    else {

                        alert("Có lỗi xảy ra");

                    }

                },
                error: function () {

                    alert("Không thể kết nối server");

                }
            });

        });

    </script>

}