@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="d-flex justify-content-center py-5">
    <div class="card shadow border-0" style="max-width:620px; width:100%; border-radius:16px;">
        <div class="card-body p-4 p-md-5 text-center">
            <div style="font-size:56px;">🔒</div>
            <h3 class="mt-2 mb-2">Bạn không có quyền truy cập trang này</h3>
            <p class="text-muted mb-4">
                Tài khoản hiện tại không được cấp quyền cho chức năng này.
                Vui lòng quay lại trang phù hợp hoặc đăng nhập bằng tài khoản khác.
            </p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="login">Đăng nhập lại</a>
            </div>
        </div>
    </div>
</div>
