@{
    ViewData["Title"] = "Danh sách lịch học";
}

<div class="container py-4">

    <h3 class="mb-4">Danh sách lớp học của Gia sư</h3>

    <div class="row g-3" id="dsLopHoc">
    </div>

</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            loadDanhSach();
        });

        function loadDanhSach() {

            $.get("/LopHoc/GETDANHSACHLICHHOC", function (data) {

                let html = "";

                data.forEach(item => {

                    let lop = item.lop;
                    let dsBuoi = item.dsBuoi || [];

                    let thoiGian = "";

                    if (dsBuoi.length > 0) {

                        thoiGian = dsBuoi
                            .slice(0, 2)
                            .map(b => `${getThu(b.thu)} - ${b.giobatdau.substring(0,5)}`)
                            .join("<br>");

                        if (dsBuoi.length > 2) {
                            thoiGian += "<br>...";
                        }
                    }

                    let trangthai = renderTrangThai(lop.trangThai);

                    html += `
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100 schedule-card" onclick="viewDetail(${lop.id})">
                            <div class="card-body">

                                <h5 class="card-title">Môn ${item.tenmon}-lớp ${lop.trinhdo}</h5>

                                <p class="mb-1"><b>Tên học viên:</b> ${item.nguoiGui.name ?? ''}</p>

                                <p class="mb-1"><b>Địa chỉ:</b> ${lop.dIaChi ?? ''}</p>

                                <p class="mb-1">
                                    <b>Thời gian:</b><br>
                                    ${thoiGian}
                                </p>

                                <p class="mb-2">
                                    ${trangthai}
                                </p>

                            </div>
                        </div>
                    </div>
                    `;
                });

                $("#dsLopHoc").html(html);

            });
        }

        function getThu(t) {

            const thu = {
                2: "Thứ 2",
                3: "Thứ 3",
                4: "Thứ 4",
                5: "Thứ 5",
                6: "Thứ 6",
                7: "Thứ 7",
                8: "Chủ nhật"
            };

            return thu[t] ?? "";
        }

        function renderTrangThai(tt) {

                   switch (tt) {

            case 1:
                return `<span class="badge bg-warning text-dark">Mới tạo</span>`;

            case 2:
                return `<span class="badge bg-info text-dark">Điều chỉnh</span>`;

            case 3:
                return `<span class="badge bg-primary">Đang dạy</span>`;

            case 4:
                return `<span class="badge bg-success">Kết thúc</span>`;

            case 5:
                return `<span class="badge bg-danger">Hủy</span>`;

            case 6:
                return `<span class="badge bg-dark">Không tiếp nhận</span>`;

            default:
                return `<span class="badge bg-secondary">Không xác định</span>`;
        }
        }

        function viewDetail(id) {
            window.location.href = "/LopHoc/Detail/" + id;
        }
    </script>
}



<style>
    .schedule-card {
        cursor: pointer;
        transition: 0.2s;
    }

        .schedule-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }
</style>