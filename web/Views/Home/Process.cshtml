@{
    ViewData["Title"] = "Quy trình";
}

<section class="py-4 py-md-5">
    <div class="text-center mb-4">
        <h1 class="section-title">Quy trình vận hành (mô phỏng tĩnh)</h1>
        <p class="text-muted">Các bước dưới đây dùng để kiểm tra trải nghiệm giao diện trước khi nối nghiệp vụ backend.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <article class="process-card h-100">
                <span class="step-number">01</span>
                <h3>Tiếp nhận</h3>
                <p>Ghi nhận thông tin phụ huynh/học viên và nhu cầu học tập.</p>
            </article>
        </div>
        <div class="col-md-3">
            <article class="process-card h-100">
                <span class="step-number">02</span>
                <h3>Sàng lọc</h3>
                <p>Đối chiếu hồ sơ gia sư phù hợp theo môn, lịch và khu vực.</p>
            </article>
        </div>
        <div class="col-md-3">
            <article class="process-card h-100">
                <span class="step-number">03</span>
                <h3>Kích hoạt lớp</h3>
                <p>Tạo lớp, gửi lịch, theo dõi điểm danh và phản hồi ban đầu.</p>
            </article>
        </div>
        <div class="col-md-3">
            <article class="process-card h-100">
                <span class="step-number">04</span>
                <h3>Đánh giá</h3>
                <p>Tổng hợp kết quả theo tuần, đề xuất cải tiến chất lượng.</p>
            </article>
        </div>
    </div>
</section>
