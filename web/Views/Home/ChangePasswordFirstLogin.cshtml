@{
    Layout = null;
    var idTk = ViewBag.IdTk ?? 0;
    var userName = ViewBag.UserName as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đổi mật khẩu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f4f6;
            font-family: Arial, sans-serif;
        }

        .card-wrap {
            width: min(460px, 92vw);
            background: white;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 10px 24px rgba(0,0,0,.08);
            padding: 20px;
        }

        .hint {
            color: #6b7280;
            font-size: .95rem;
        }

        .message {
            font-size: .92rem;
            margin-top: 10px;
        }

        .message.error { color: #dc2626; }
        .message.success { color: #059669; }
    </style>
</head>
<body>
    <div class="card-wrap">
        <h4 class="mb-2">Đổi mật khẩu mới</h4>
        <p class="hint mb-3">Xin chào <b>@userName</b>, bạn có thể đổi mật khẩu ngay bây giờ hoặc để sau.</p>

        <div class="mb-2">
            <label class="form-label">Mật khẩu mới</label>
            <input type="password" class="form-control" id="newPass" placeholder="Nhập mật khẩu mới" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nhập lại mật khẩu</label>
            <input type="password" class="form-control" id="confirmPass" placeholder="Nhập lại mật khẩu" />
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary flex-fill" id="btnChangePass">Lưu mật khẩu mới</button>
            <a class="btn btn-outline-secondary" href="/LopHoc/Index">Để sau</a>
        </div>

        <div id="msg" class="message"></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        const idTk = @idTk;

        function showMessage(text, isSuccess) {
            const el = $("#msg");
            el.text(text);
            el.removeClass("error success").addClass(isSuccess ? "success" : "error");
        }

        $("#btnChangePass").on("click", function () {
            const pass = $("#newPass").val()?.trim();
            const confirm = $("#confirmPass").val()?.trim();

            if (!pass || !confirm) {
                showMessage("Vui lòng nhập đầy đủ thông tin.", false);
                return;
            }

            if (pass.length < 6) {
                showMessage("Mật khẩu mới phải từ 6 ký tự trở lên.", false);
                return;
            }

            if (pass !== confirm) {
                showMessage("Mật khẩu xác nhận chưa khớp.", false);
                return;
            }

            $.ajax({
                url: "/USER/ChangePass",
                type: "POST",
                data: {
                    pass: pass,
                    id: idTk,
                    type:1
                },
                success: function (res) {
                    if (res?.success) {
                        showMessage("Đổi mật khẩu thành công. Đang chuyển sang Lịch của tôi...", true);
                        setTimeout(function () {
                            window.location.href = "/LopHoc/Index";
                        }, 900);
                        return;
                    }

                    showMessage(res?.message || "Đổi mật khẩu thất bại.", false);
                },
                error: function () {
                    showMessage("Không thể kết nối máy chủ.", false);
                }
            });
        });
    </script>
</body>
</html>
