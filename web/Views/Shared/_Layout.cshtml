<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LQH Eduction</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/He_thong_Quan_Ly_trung_tam_gia_su.styles.css" asp-append-version="true" />
</head>
<body>

    @{
        var userId = Context.Session.GetInt32("UserId");
        var TypeUsser = Context.Session.GetInt32("TypeUsser");
        var userName = Context.Session.GetString("UserName");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">LQH Eduction</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Services">Dịch vụ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Process">Quy trình</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="FAQ">FAQ</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                        </li>
                         @if (!string.IsNullOrEmpty(userName))
                        {
                            if (TypeUsser == 2)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="MonHoc" asp-action="Index">Danh sách môn học</a>
                                </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="LopHoc" asp-action="Index">Lịch đã đăng ký</a>
                            </li>
                            }
                            if (TypeUsser==1)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="home" asp-action="TutorDashboard">Dach sách lớp học</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="LopHoc" asp-action="thongbaolich">Lịch dậy</a>
                                </li>
                            }
                           
                        }
                    </ul>

                    <ul class="navbar-nav">

                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item dropdown d-flex align-items-center me-3">
                                <a class="nav-link dropdown-toggle position-relative" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span style="font-size:20px;">&#128276;</span>
                                    <span class="position-absolute top-25 start-100 translate-middle badge rounded-pill bg-danger" id="noti-count" style="display: none; font-size: 0.65em;">
                                        0
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationDropdown" style="width: 320px; max-height: 400px; overflow-y: auto;">
                                    <li><h6 class="dropdown-header">Thông báo của bạn</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <div id="noti-list">
                                        <li><span class="dropdown-item text-center text-muted small">Đang tải...</span></li>
                                    </div>
                                </ul>
                            </li>
                            <li class="nav-item d-flex align-items-center me-3 text-muted small">
                                Xin chào, @userName
                            </li>
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle d-flex align-items-center"
                                   href="#"
                                   id="userMenu"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <span style="font-size:20px;">&#9776;</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow"
                                    aria-labelledby="userMenu">

                                    

                                    <li>
                                        <a class="dropdown-item"
                                           href="/USER/AddOrEdit?idtk=@userId">
                                            Chỉnh sửa thông tin
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <form asp-controller="Home"
                                              asp-action="Logout"
                                              method="post">
                                            <button class="dropdown-item text-danger"
                                                    type="submit">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>

                                </ul>
                            </li>
                           
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Home"
                                   asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LQH Eduction - <a asp-area="" asp-controller="Home" asp-action="Privacy">Giới thiệu</a> - <a asp-area="" asp-controller="Home" asp-action="Policy">Chính sách</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            const accessDeniedMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["AccessDeniedMessage"]?.ToString()));

            if (!accessDeniedMessage) return;

            Swal.fire({
                icon: 'warning',
                title: 'Không thể truy cập',
                text: accessDeniedMessage,
                confirmButtonText: 'Đã hiểu',
                confirmButtonColor: '#0d6efd',
                background: '#fff',
                color: '#1f2937',
                customClass: {
                    popup: 'shadow rounded-4 border-0',
                    title: 'fw-bold',
                    confirmButton: 'px-4 py-2 rounded-pill'
                }
            });
        })();
    </script>
    <script>
        console.log("UserID:", "@userId");
        console.log("UserName:", "@userName");
    </script>

    @if (!string.IsNullOrEmpty(userName))
    {
        <script>
            $(document).ready(function () {
                // Tải thông báo khi trang vừa mở
                FetchNotifications();
                // Thiết lập tự động tải lại thông báo mỗi 30 giây (30000 ms)
                setInterval(FetchNotifications, 30000);

                function FetchNotifications() {
                    $.ajax({
                        url: '/Home/GetAppNotifications', // Đường dẫn tới hàm trong HomeController
                        type: 'GET',
                        success: function (data) {
                            if (data.success) {
                                // Cập nhật số lượng thông báo chưa đọc trên chuông
                                if (data.unreadCount > 0) {
                                    $('#noti-count').text(data.unreadCount).show();
                                } else {
                                    $('#noti-count').hide();
                                }

                                // Cập nhật danh sách thông báo vào dropdown
                                var html = '';
                                if (data.items && data.items.length > 0) {
                                    $.each(data.items, function (i, item) {
                                        // Nếu chưa đọc thì tô đậm, đọc rồi thì bình thường
                                        var bgClass = item.isRead ? '' : 'bg-light fw-bold';
                                        html += `<li>
                                                    <a class="dropdown-item text-wrap border-bottom ${bgClass}" style="font-size: 14px; white-space: normal;" href="${item.link}" onclick="MarkAsRead(${item.id})">
                                                        ${item.message}
                                                        <br><small class="text-muted" style="font-size: 11px;">${item.timeAgo}</small>
                                                    </a>
                                                 </li>`;
                                    });
                                } else {
                                    html = '<li><span class="dropdown-item text-center text-muted small">Không có thông báo mới</span></li>';
                                }
                                $('#noti-list').html(html);
                            }
                        },
                        error: function (err) {
                            console.log("Lỗi tải thông báo", err);
                        }
                    });
                }
            });

            // Hàm đánh dấu đã đọc khi click vào thông báo
            function MarkAsRead(id) {
                $.post('/Home/DanhDauDaDoc', { id: id });
            }
        </script>
    }
</body>
</html>