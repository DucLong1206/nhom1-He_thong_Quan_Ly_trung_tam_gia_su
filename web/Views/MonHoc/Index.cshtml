@{
    ViewData["Title"] = "Danh sách gia sư";
}

<style>

    .gs-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .gs-card {
        display: flex;
        align-items: center;
        background: #fff;
        border: 1px solid #e8e8f0;
        border-radius: 14px;
        padding: 16px;
        cursor: pointer;
        transition: 0.2s;
    }

        .gs-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        }

    .gs-avatar {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: linear-gradient(135deg,#6c63ff,#48cfad);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #fff;
        object-fit: cover;
    }

    .gs-divider {
        width: 1px;
        height: 50px;
        background: #eee;
        margin: 0 15px;
    }

    .gs-info {
        flex: 1;
    }

    .gs-name {
        font-weight: 700;
        margin-bottom: 6px;
    }

    .gs-tags {
        display: flex;
        gap: 6px;
        margin-bottom: 6px;
    }

    .gs-tag {
        font-size: 12px;
        padding: 3px 8px;
        border-radius: 20px;
    }

    .subject {
        background: #eef2ff;
        color: #6366f1;
    }

    .area {
        background: #fff4e6;
        color: #d97706;
    }

    .gs-price {
        font-weight: 700;
        color: #059669;
    }

    .price-filter {
        padding: 10px;
        border: 1px solid #eee;
        border-radius: 10px;
    }

    .gs-loading {
        text-align: center;
        padding: 40px;
    }

    .gs-empty {
        text-align: center;
        padding: 40px;
        color: #999;
    }

</style>

<h3 class="mb-3">Tìm gia sư</h3>

<form id="filterForm" class="row g-3 mb-4">

    <div class="col-md-3">
        <label>Từ khóa</label>
        <input class="form-control" name="keyword" placeholder="Tên gia sư...">
    </div>

    <div class="col-md-3">
        <label>Môn học</label>
        <select class="form-select" name="monHocId" id="monHocId">
            <option value="">Tất cả</option>
        </select>
    </div>

    <div class="col-md-3">

        <label>Giá tối đa / giờ</label>

        <div class="price-filter">

            <input type="range" id="priceRange" min="0" max="500000" step="50000" value="0" class="form-range">

            <div class="d-flex gap-2 mt-2">

                <input type="number" id="priceInput" class="form-control">

                <span class="align-self-center">VNĐ</span>

            </div>

            <small>
                Giá: <span id="priceLabel">0</span> VNĐ
            </small>

        </div>

    </div>

    <div class="col-md-3">
        <label>Sắp xếp</label>
        <select class="form-select" name="sort">
            <option value="price_asc">Giá tăng</option>
            <option value="price_desc">Giá giảm</option>
        </select>
    </div>

    <div class="col-12">
        <button class="btn btn-primary">Tìm kiếm</button>
    </div>

</form>


<div class="gs-list">

    <div class="gs-loading">Đang tải...</div>

</div>



<script>

    const priceRange=document.getElementById("priceRange")
    const priceInput=document.getElementById("priceInput")
    const priceLabel=document.getElementById("priceLabel")

    priceRange.oninput=function(){

    priceInput.value=this.value
    priceLabel.innerText=Number(this.value).toLocaleString()

    }

    priceInput.oninput=function(){

    priceRange.value=this.value
    priceLabel.innerText=Number(this.value).toLocaleString()

    }

    document.addEventListener("DOMContentLoaded",function(){

    loadSubjects()

    loadData()

    document.getElementById("filterForm").addEventListener("submit",function(e){

    e.preventDefault()

    loadData()

    })

    })



    function loadSubjects(){

    $.ajax({

    url:"/USER/getlisstmonhoc",

    type:"GET",

    success:function(res){

    let html='<option value="">Tất cả</option>'

    res.data.forEach(x=>{

    html+=`<option value="${x.id}">${x.name}</option>`

    })

    $("#monHocId").html(html)

    }

    })

    }



    function loadData(){

    const container=document.querySelector(".gs-list")

    container.innerHTML='<div class="gs-loading">Đang tải...</div>'


    const keyword=document.querySelector("[name='keyword']").value || ""
    const idmon=document.querySelector("[name='monHocId']").value || 0
    const sort=document.querySelector("[name='sort']").value

    let sapxep=0

    if(sort==="price_desc") sapxep=1
    if(sort==="price_asc") sapxep=2

    let gia=document.getElementById("priceRange").value || 0

    $.ajax({

    url:"/MonHoc/getlist",

    type:"GET",

    data:{
    keyword:keyword,
    idmon:idmon,
    gia:gia,
    sapxep:sapxep
    },

    success:function(res){

    renderList(res.data)

    },

    error:function(){

    container.innerHTML='<div class="gs-empty">Lỗi tải dữ liệu</div>'

    }

    })

    }



    function getInitials(name){

    if(!name) return "GS"

    let arr=name.split(" ")

    return (arr[0][0]+arr[arr.length-1][0]).toUpperCase()

    }



    function getAvatar(item){

    if(item.avata && item.avata!==""){

    return `<img src="${item.avata}" class="gs-avatar">`

    }

    return `<div class="gs-avatar">${getInitials(item.name)}</div>`

    }



    function renderList(data){
        const container=document.querySelector(".gs-list")
        container.innerHTML=""

        if(!data || data.length===0){
            container.innerHTML='<div class="gs-empty">Không có dữ liệu</div>'
            return
        }

        data.forEach(item=>{
            const avatar=getAvatar(item)

            // ĐIỂM QUAN TRỌNG NHẤT LÀ DÒNG DƯỚI ĐÂY:
            // Đã thêm tham số &idmon=${item.idMon} vào URL để phân biệt môn học
            const html=`
            <a class="gs-card text-decoration-none" href="/MonHoc/TutorDetail?id=${item.id}&idmon=${item.idMon}">
                ${avatar}
                <div class="gs-divider"></div>
                <div class="gs-info">
                    <div class="gs-name">${item.name}</div>
                    <div class="gs-tags">
                        <span class="gs-tag subject">${item.mon} - Lớp ${item.trinhdo}</span>
                        <span class="gs-tag area">${item.xa}</span>
                    </div>
                    <div class="gs-price">
                        ${Number(item.giaTheoGio).toLocaleString()} VNĐ / giờ
                    </div>
                </div>
            </a>
            `
            container.insertAdjacentHTML("beforeend",html)
        })
    }

</script>