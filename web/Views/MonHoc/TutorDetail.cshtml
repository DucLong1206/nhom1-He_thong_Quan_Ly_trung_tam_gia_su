@{
    ViewData["Title"] = "Chi tiết gia sư";

    var tutorName = ViewData["TutorName"] as string ?? "Gia sư mẫu";
    var mon = $"{ViewData["Mon"] ?? "Đang cập nhật"} - lớp {ViewData["Trinhdo"]}";
    var xa = ViewData["Xa"] as string ?? "Đang cập nhật";
    var giaTheoGio = ViewData["GiaTheoGio"] as decimal? ?? 120000;
    var Trinhdo = ViewData["Trinhdo"] as int? ?? -1;
    var IDXa = ViewData["IDXa"] as int? ?? -1;
    var ID = ViewData["ID"] as int? ?? -1;
    var IDMon = ViewData["IDMon"] as int? ?? -1;
    var avata = ViewData["avata"] as string ?? null;
}

<style>
    .detail-wrap {
        max-width: 980px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 20px;
    }

    .detail-card {
        background: #fff;
        border: 1px solid #eceff4;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    }

    .detail-head {
        display: flex;
        gap: 16px;
        align-items: center;
        margin-bottom: 16px;
    }

    .detail-avatar {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #6c63ff, #48cfad);
        overflow: hidden;
        flex-shrink: 0;
    }

        .detail-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 16px;
        }

    .meta-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 12px;
    }

    .meta-box {
        border: 1px solid #e7eaf3;
        border-radius: 12px;
        padding: 12px;
        text-align: center;
        background: #f9fafc;
    }

    .meta-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #374151;
    }

    .meta-label {
        font-size: 0.8rem;
        color: #6b7280;
    }

    .comment-item {
        padding: 10px 0;
        border-bottom: 1px dashed #e5e7eb;
    }

        .comment-item:last-child {
            border-bottom: none;
        }

    .booking-form .form-control,
    .booking-form .form-select {
        border-radius: 10px;
    }

    @@media (max-width: 992px) {
        .detail-wrap {
            grid-template-columns: 1fr;
        }

        .meta-grid {
            grid-template-columns: 1fr;
        }
    }

    /* --- CSS CHO KHUNG BÌNH LUẬN --- */
    #commentList {
        max-height: 350px; /* Giới hạn chiều cao khung bình luận */
        overflow-y: auto;  /* Tự động hiện thanh cuộn dọc nếu nội dung bị tràn */
        padding-right: 8px; /* Lùi vào một chút để không bị dính vào thanh cuộn */
    }

    /* Làm đẹp thanh cuộn (Tùy chọn, nhìn sẽ rất Pro) */
    #commentList::-webkit-scrollbar {
        width: 6px;
    }
    #commentList::-webkit-scrollbar-track {
        background: #f8f9fa; 
        border-radius: 10px;
    }
    #commentList::-webkit-scrollbar-thumb {
        background: #d1d5db; 
        border-radius: 10px;
    }
    #commentList::-webkit-scrollbar-thumb:hover {
        background: #9ca3af; 
    }
</style>

<h1 class="mb-4">Chi tiết gia sư</h1>

<div class="detail-wrap">
    <section class="detail-card">
        <div class="detail-head">
            <!-- Avatar: ảnh hoặc chữ viết tắt -->
            <div class="detail-avatar" id="avatarEl">
                @if (!string.IsNullOrWhiteSpace(avata))
                {
                    <img src="@avata" alt="@tutorName"
                         onerror="this.parentElement.innerHTML='<span id=initials-fallback></span>'; setInitials();" />
                }
            </div>

            <div>
                <h3 class="mb-1">@tutorName</h3>
                <div class="text-muted">Môn: @mon</div>
                <div class="text-muted">Khu vực: @xa</div>
                <div class="fw-bold text-success mt-1">@giaTheoGio.ToString("N0") VNĐ / giờ</div>
            </div>
        </div>

        <p class="mb-2">
            <strong>Giới thiệu:</strong>
            Gia sư có kinh nghiệm dạy kèm 1-1, hỗ trợ lộ trình học theo năng lực học sinh và cập nhật kết quả mỗi buổi.
        </p>

        <div class="meta-grid">
            <div class="meta-box">
                <div class="meta-value" id="soMon">3</div>
                <div class="meta-label">Số môn đang dạy</div>
            </div>
            <div class="meta-box">
                <div class="meta-value" id="soHocSinh">18</div>
                <div class="meta-label">Học sinh đã đăng ký</div>
            </div>
            <div class="meta-box">
                <div class="meta-value" id="danhGia">4.8/5</div>
                <div class="meta-label">Đánh giá trung bình</div>
            </div>
        </div>

        <h5 class="mt-4">Bình luận gần đây</h5>
        <div class="mb-3">
            <textarea class="form-control mb-2" id="txtBinhLuan" rows="2" placeholder="Chia sẻ trải nghiệm của bạn về gia sư này..."></textarea>
            <button class="btn btn-sm btn-primary" onclick="guiBinhLuan()">Gửi bình luận</button>
        </div>
        <div id="commentList"></div>
    </section>

    <aside class="detail-card">
        <h5 class="mb-3">Đặt lịch học</h5>
        <form class="booking-form" id="bookingForm">

            <div class="mb-3">
                <label class="form-label">Họ tên học sinh</label>
                <input class="form-control" id="studentName" placeholder="Nhập họ tên" />
            </div>

            <div class="mb-3">
                <label class="form-label">Địa chỉ học</label>
                <input class="form-control" id="address" placeholder="Nhập địa chỉ học" />
            </div>

            <div class="mb-3">
                Môn học: @mon
            </div>

            <!-- DANH SÁCH BUỔI HỌC -->
            <div class="mb-2 d-flex justify-content-between align-items-center">
                <label class="form-label mb-0">Lịch học trong tuần</label>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addScheduleRow()">
                    + Thêm buổi
                </button>
            </div>

            <div id="scheduleContainer"></div>

            <!-- NGÀY BẮT ĐẦU -->
            <div class="mb-3 mt-3">
                <label class="form-label">Ngày bắt đầu</label>
                <input type="date" class="form-control" id="startDate" />
            </div>

            <!-- NGÀY KẾT THÚC -->
            <div class="mb-3">
                <label class="form-label">Ngày kết thúc</label>
                <input type="date" class="form-control" id="endDate" />
            </div>

            <button type="button" class="btn btn-primary w-100" onclick="submitBooking()">
                Gửi yêu cầu đặt lịch
            </button>

            <a href="/LopHoc/index" class="btn btn-outline-secondary w-100 mt-2">
                Xem các lịch đã đăng ký
            </a>

        </form>
    </aside>
</div>

<script>
    // -------------------------------------------------------
    // Lấy chữ viết tắt từ tên
    // -------------------------------------------------------
    function getInitials(name) {
        if (!name) return "GS";
        const parts = name.trim().split(" ").filter(Boolean);
        if (parts.length >= 2)
            return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        return name.substring(0, 2).toUpperCase();
    }

    const _tutorName = "@tutorName";
    const _initials  = getInitials(_tutorName);
    const _avata     = "@(avata ?? "")";   // chuỗi rỗng nếu null

    // -------------------------------------------------------
    // Xử lý avatar khi DOM sẵn sàng & Load dữ liệu thật
    // -------------------------------------------------------
    // Lấy ID gia sư từ Razor ra một biến JS để dùng chung cho an toàn
    const GIA_SU_ID = @(ViewData["ID"] ?? 0);

    document.addEventListener("DOMContentLoaded", function () {
        const avatarEl = document.getElementById("avatarEl");

        if (!_avata || _avata.trim() === "") {
            avatarEl.textContent = _initials;
        }

        // --- ĐỔ DỮ LIỆU THỐNG KÊ TỪ CONTROLLER ---
        document.getElementById("soMon").textContent      = "@ViewBag.SoMon";
        document.getElementById("soHocSinh").textContent  = "@ViewBag.SoHocSinh";
        document.getElementById("danhGia").textContent    = "@ViewBag.DanhGia";

        // Tự động load bình luận từ DB khi vừa mở trang
        loadBinhLuan();
    });

    // -------------------------------------------------------
    // API Bình Luận
    // -------------------------------------------------------
    function loadBinhLuan() {
        $.get("/MonHoc/GetBinhLuan?idGiaSu=" + GIA_SU_ID, function (res) {
            let html = "";
            if (!res || res.length === 0) {
                html = "<div class='text-muted small'>Chưa có bình luận nào.</div>";
            } else {
                res.forEach(c => {
                    html += `<div class="comment-item">
                                <strong>${c.ten}</strong> <small class="text-muted">(${c.ngayTao})</small>
                                <p class="mb-0 mt-1">${c.noiDung}</p>
                             </div>`;
                });
            }
            document.getElementById("commentList").innerHTML = html;
        });
    }

    function guiBinhLuan() {
        let noiDung = document.getElementById("txtBinhLuan").value;
        if (!noiDung.trim()) {
            alert("Vui lòng nhập nội dung bình luận!"); 
            return;
        }

        $.post("/MonHoc/DangBinhLuan", { idGiaSu: GIA_SU_ID, noiDung: noiDung }, function (res) {
            if (res.success) {
                document.getElementById("txtBinhLuan").value = ""; // Xóa trắng ô nhập
                loadBinhLuan(); // Tải lại danh sách bình luận mới nhất
            } else {
                alert(res.message); // Báo lỗi (VD: Chưa đăng nhập, không phải phụ huynh)
            }
        }).fail(function() {
            alert("Có lỗi kết nối tới máy chủ.");
        });
    }

    // Fallback khi ảnh lỗi (gọi từ onerror trong Razor)
    function setInitials() {
        const el = document.getElementById("avatarEl");
        if (el) el.textContent = _initials;
    }

    // -------------------------------------------------------
    // Tạo options giờ
    // -------------------------------------------------------
    function generateTimeOptions() {
        let options = '<option value="">Chọn giờ</option>';
        for (let h = 0; h < 24; h++) {
            const start = String(h).padStart(2, '0') + ":00";
            const end   = String(h + 1).padStart(2, '0') + ":00";
            options += `<option value="${start} - ${end}">${start} - ${end}</option>`;
        }
        return options;
    }

    // -------------------------------------------------------
    // Thêm hàng buổi học
    // -------------------------------------------------------
    function addScheduleRow() {
        const container = document.getElementById("scheduleContainer");
        const row = document.createElement("div");
        row.className = "card p-3 mb-2";
        row.innerHTML = `
            <div class="row g-2">
                <div class="col-5">
                    <select class="form-select thu">
                        <option value="">Chọn thứ</option>
                        <option>Thứ 2</option>
                        <option>Thứ 3</option>
                        <option>Thứ 4</option>
                        <option>Thứ 5</option>
                        <option>Thứ 6</option>
                        <option>Thứ 7</option>
                        <option>Chủ nhật</option>
                    </select>
                </div>
                <div class="col-5">
                    <select class="form-select gio">
                        ${generateTimeOptions()}
                    </select>
                </div>
                <div class="col-2 d-flex align-items-center">
                    <button type="button" class="btn btn-sm btn-danger w-100"
                            onclick="this.closest('.card').remove()">X</button>
                </div>
            </div>`;
        container.appendChild(row);
    }

    // -------------------------------------------------------
    // Submit đặt lịch
    // -------------------------------------------------------
    function submitBooking() {
        const address   = $("#address").val();
        const startDate = $("#startDate").val();
        const endDate   = $("#endDate").val();
        const rows      = $("#scheduleContainer .card");

        const thuMap = {
            "Thứ 2": 2, "Thứ 3": 3, "Thứ 4": 4,
            "Thứ 5": 5, "Thứ 6": 6, "Thứ 7": 7, "Chủ nhật": 8
        };

        let dsBuoi = [];
        rows.each(function () {
            const thuText = $(this).find(".thu").val();
            const gioText = $(this).find(".gio").val();
            if (!thuText || !gioText) return;
            const times = gioText.split(" - ");
            dsBuoi.push({
                ID: 0,
                IDlophoc: 0,
                thu: thuMap[thuText],
                giobatdau:  times[0] + ":00",
                gioketthuc: times[1] + ":00"
            });
        });

        if (dsBuoi.length === 0) {
            alert("Phải thêm ít nhất một buổi học");
            return;
        }

        const data = {
            lop: {
                ID: 0,
                IDxa:        @IDXa,
                idnguoitao:  0,
                idnguoinhan: @ID,
                DIaChi:      address,
                NgayBatdau:  startDate,
                NgayKetthuc: endDate ? endDate : null,
                sotienMotBuoi: @giaTheoGio,
                PhiMoiGioi:  0,
                trinhdo:     @Trinhdo,
                idmon:       @IDMon
            },
            dsBuoi: dsBuoi
        };

        $.ajax({
            url:         '/MonHoc/Save',
            type:        'POST',
            contentType: 'application/json',
            data:        JSON.stringify(data),
            success: function (result) {
                if (result.success) {
                    alert("Lưu thành công!");
                    location.reload();
                } else {
                    alert(result.message);
                }
            },
            error: function (err) {
                console.error(err);
                alert("Có lỗi xảy ra");
            }
        });
    }
</script>
