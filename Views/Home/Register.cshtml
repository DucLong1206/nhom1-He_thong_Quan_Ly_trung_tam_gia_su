@model He_thong_Quan_Ly_trung_tam_gia_su.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container mt-5" style="max-width:520px;">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="mb-3">Đăng ký tài khoản</h3>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Tài khoản</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TypeUser" class="form-label">Loại người dùng</label>
                    <select asp-for="TypeUser" class="form-select">
                        <option value="">-- Chọn loại --</option>
                        <option value="1">Gia sư</option>
                        <option value="2">Phụ huynh</option>
                    </select>
                    <div class="form-text">Nhân viên/Admin (TypeUser = 3) không cho đăng ký tại đây.</div>
                    <span asp-validation-for="TypeUser" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Đăng ký</button>
                <a asp-action="login" class="btn btn-link">Đã có tài khoản? Đăng nhập</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
