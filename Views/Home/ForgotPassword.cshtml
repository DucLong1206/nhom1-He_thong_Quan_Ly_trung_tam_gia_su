@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu</title>
    <link rel="stylesheet" href="~/css/forgot-password.css" />
</head>
<body>
    <div class="forgot-password-wrapper">
        <div class="forgot-password-card">
            <h2>Quên mật khẩu</h2>
            <p>Nhập email đã đăng ký. Chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu cho bạn.</p>

            <form>
                <label for="email">Email</label>
                <input id="email" type="email" name="email" placeholder="example@gmail.com" required />
                <button type="submit">Gửi yêu cầu</button>
            </form>

            <a asp-action="login" class="back-link">← Quay lại đăng nhập</a>
        </div>
    </div>
</body>
</html>
