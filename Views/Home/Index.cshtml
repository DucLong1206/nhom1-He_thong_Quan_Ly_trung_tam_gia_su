@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero-section py-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-6">
            <span class="hero-badge">Trung tâm gia sư LQH Eduction</span>
            <h1 class="hero-title mt-3">Kết nối gia sư chất lượng với học viên phù hợp</h1>
            <p class="hero-subtitle mt-3">
                Nền tảng quản lý lớp học, lịch dạy và theo dõi tiến độ giúp phụ huynh,
                học viên và gia sư phối hợp hiệu quả hơn mỗi ngày.
            </p>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="login">Đăng nhập hệ thống</a>
                <a class="btn btn-outline-primary btn-lg" href="#features">Khám phá tính năng</a>
            </div>

            <div class="hero-stats mt-4">
                <div class="stat-item">
                    <strong>500+</strong>
                    <span>Học viên đang theo học</span>
                </div>
                <div class="stat-item">
                    <strong>120+</strong>
                    <span>Gia sư đã xác thực</span>
                </div>
                <div class="stat-item">
                    <strong>95%</strong>
                    <span>Phụ huynh hài lòng</span>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="hero-card">
                <h2>Bảng tổng quan nhanh</h2>
                <ul>
                    <li>✅ Quản lý hồ sơ học viên và gia sư tập trung.</li>
                    <li>✅ Theo dõi lớp học, lịch dạy và trạng thái ghép lớp.</li>
                    <li>✅ Quản lý học phí, lương gia sư theo từng kỳ.</li>
                    <li>✅ Báo cáo tiến độ học tập theo tuần/tháng.</li>
                </ul>
                <p class="mb-0 text-muted">* Giao diện mẫu cho hệ thống quản lý trung tâm.</p>
            </div>
        </div>
    </div>
</section>

<section id="features" class="features-section py-5">
    <div class="text-center mb-4">
        <h2 class="section-title">Tính năng nổi bật</h2>
        <p class="text-muted">Những công cụ cốt lõi giúp trung tâm vận hành chuyên nghiệp.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <article class="feature-card h-100">
                <h3>Quản lý học viên</h3>
                <p>Quản lý thông tin cá nhân, lớp đang học, tiến độ và ghi chú học tập.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="feature-card h-100">
                <h3>Quản lý gia sư</h3>
                <p>Lưu hồ sơ chuyên môn, lịch rảnh và hiệu suất giảng dạy theo từng môn.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="feature-card h-100">
                <h3>Ghép lớp thông minh</h3>
                <p>Đề xuất gia sư phù hợp dựa trên môn học, thời gian và khu vực.</p>
            </article>
        </div>
    </div>
</section>

<section class="process-section py-5">
    <div class="text-center mb-4">
        <h2 class="section-title">Luồng xử lý nhanh</h2>
        <p class="text-muted">Luồng nghiệp vụ rõ ràng để đội ngũ trung tâm dễ theo dõi và xử lý.</p>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <article class="process-card h-100">
                <span class="step-number">01</span>
                <h3>Tiếp nhận yêu cầu</h3>
                <p>Thu thập thông tin học viên, môn học, lịch học mong muốn và khu vực.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="process-card h-100">
                <span class="step-number">02</span>
                <h3>Ghép gia sư</h3>
                <p>Đối chiếu hồ sơ và đề xuất gia sư phù hợp theo chuyên môn và thời gian.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="process-card h-100">
                <span class="step-number">03</span>
                <h3>Theo dõi & đánh giá</h3>
                <p>Quản lý tiến độ theo tuần, phản hồi phụ huynh và tối ưu chất lượng lớp học.</p>
            </article>
        </div>
    </div>
</section>

<section class="cta-section text-center py-5">
    <h2>Sẵn sàng triển khai hệ thống quản lý cho trung tâm?</h2>
    <p class="mb-4">Bắt đầu từ trang chủ này và mở rộng dần các module nghiệp vụ cốt lõi.</p>
    <a class="btn btn-success btn-lg" asp-controller="Home" asp-action="login">Bắt đầu ngay</a>
</section>

<div id="db-status" class="alert d-none mt-4" role="status"></div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const statusDiv = document.getElementById("db-status");

            try {
                const data = await window.appApi.get('@Url.Action("DbHealth", "Home")');
                statusDiv.classList.remove("d-none");

                if (data.success) {
                    statusDiv.classList.add("alert-success");
                    statusDiv.innerHTML = `<strong>${data.message}</strong><br/>Tổng tài khoản: ${data.totalTaiKhoan}`;
                } else {
                    statusDiv.classList.add("alert-danger");
                    statusDiv.innerHTML = `<strong>${data.message}</strong>`;
                }
            } catch {
                statusDiv.classList.remove("d-none");
                statusDiv.classList.add("alert-danger");
                statusDiv.textContent = "Không gọi được API kiểm tra DB.";
            }
        });
    </script>
}
