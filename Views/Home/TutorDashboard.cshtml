@{
    ViewData["Title"] = "Danh sách lịch học";
}

<div class="container py-4">

    <h3 class="mb-4">Danh sách lớp học của Gia sư</h3>

    <div class="row g-3">

        <!-- LỚP MỚI TẠO -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 schedule-card" onclick="viewDetail(1)">
                <div class="card-body">
                    <h5 class="card-title">Toán lớp 10</h5>
                    <p class="mb-1"><b>Học sinh:</b> Nguyễn Văn A</p>
                    <p class="mb-1"><b>Thời gian:</b> Thứ 2 - 18:00</p>
                    <p class="mb-2">
                        <span class="badge bg-warning text-dark">Mới tạo</span>
                    </p>

                    <div class="d-flex gap-2">
                        <button class="btn btn-success btn-sm">Ký hợp đồng</button>
                        <button class="btn btn-danger btn-sm">Từ chối</button>
                    </div>
                </div>
            </div>
        </div>


        <!-- TRẠNG THÁI CHẤP NHẬN -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 schedule-card" onclick="viewDetail(2)">
                <div class="card-body">
                    <h5 class="card-title">Tiếng Anh lớp 9</h5>
                    <p class="mb-1"><b>Học sinh:</b> Trần Minh B</p>
                    <p class="mb-1"><b>Thời gian:</b> Thứ 3 - 19:00</p>
                    <p class="mb-2">
                        <span class="badge bg-success">Đã chấp nhận</span>
                    </p>

                    <button class="btn btn-warning btn-sm">
                        Điều chỉnh lịch
                    </button>
                </div>
            </div>
        </div>


        <!-- ĐANG DIỄN RA -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 schedule-card" onclick="viewDetail(3)">
                <div class="card-body">
                    <h5 class="card-title">Vật lý lớp 11</h5>
                    <p class="mb-1"><b>Học sinh:</b> Lê Hoàng C</p>
                    <p class="mb-1"><b>Thời gian:</b> Thứ 4 - 17:00</p>
                    <p class="mb-2">
                        <span class="badge bg-primary">Đang diễn ra</span>
                    </p>

                    <button class="btn btn-info btn-sm">
                        Xem tiến độ
                    </button>
                </div>
            </div>
        </div>


        <!-- HOÀN THÀNH -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 schedule-card" onclick="viewDetail(4)">
                <div class="card-body">
                    <h5 class="card-title">Hóa học lớp 12</h5>
                    <p class="mb-1"><b>Học sinh:</b> Phạm Văn D</p>
                    <p class="mb-1"><b>Thời gian:</b> Thứ 6 - 18:00</p>
                    <p class="mb-2">
                        <span class="badge bg-success">Hoàn thành</span>
                    </p>

                    <button class="btn btn-secondary btn-sm">
                        Xem kết quả
                    </button>
                </div>
            </div>
        </div>


        <!-- HỦY -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 schedule-card" onclick="viewDetail(5)">
                <div class="card-body">
                    <h5 class="card-title">Sinh học lớp 10</h5>
                    <p class="mb-1"><b>Học sinh:</b> Nguyễn Thị E</p>
                    <p class="mb-1"><b>Thời gian:</b> Thứ 7 - 16:00</p>
                    <p class="mb-2">
                        <span class="badge bg-danger">Đã hủy</span>
                    </p>

                    <button class="btn btn-outline-secondary btn-sm">
                        Xem lý do
                    </button>
                </div>
            </div>
        </div>

    </div>

</div>


<script>
    function viewDetail(id) {
        window.location.href = "/LopHoc/Detail/" + id;
    }
</script>


<style>
    .schedule-card {
        cursor: pointer;
        transition: 0.2s;
    }

        .schedule-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }
</style>