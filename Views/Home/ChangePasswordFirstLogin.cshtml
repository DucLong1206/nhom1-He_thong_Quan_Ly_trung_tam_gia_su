@{
    Layout = null;
    var idTk = ViewBag.IdTk ?? 0;
    var userName = ViewBag.UserName as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đổi mật khẩu lần đầu</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <style>
        .change-pass-card {
            width: min(420px, 92vw);
            background: rgba(17, 17, 17, .95);
            border: 1px solid rgba(255, 102, 0, .28);
            border-radius: 16px;
            padding: 24px;
            color: #fff;
            position: relative;
            z-index: 2;
            box-shadow: 0 16px 40px rgba(0, 0, 0, .35);
        }

        .change-pass-card h2 {
            margin: 0 0 8px;
            color: #ff9a3c;
        }

        .change-pass-card p {
            margin: 0 0 16px;
            color: #d6d6d6;
            font-size: .95rem;
        }

        .change-pass-card input {
            width: 100%;
            margin-bottom: 12px;
            border-radius: 10px;
            border: 1px solid #2e2e2e;
            background: #1b1b1b;
            color: #fff;
            padding: 11px 12px;
            outline: none;
        }

        .change-pass-card button {
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            background: linear-gradient(90deg, #ff7f2a, #ff5e00);
            color: white;
            font-weight: 600;
        }

        .message {
            margin-top: 12px;
            font-size: .92rem;
        }

        .message.error {
            color: #ff8f8f;
        }

        .message.success {
            color: #96ff9f;
        }
    </style>
</head>
<body>
    <div class="background" id="bgGrid"></div>

    <div class="change-pass-card">
        <h2>Đổi mật khẩu bắt buộc</h2>
        <p>Tài khoản <b>@userName</b> cần đổi mật khẩu trước khi tiếp tục sử dụng hệ thống.</p>

        <input type="password" id="newPass" placeholder="Mật khẩu mới" />
        <input type="password" id="confirmPass" placeholder="Nhập lại mật khẩu mới" />
        <button type="button" id="btnChangePass">Xác nhận đổi mật khẩu</button>

        <div id="msg" class="message"></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        const idTk = @idTk;

        function showMessage(text, isSuccess) {
            const el = $("#msg");
            el.text(text);
            el.removeClass("error success").addClass(isSuccess ? "success" : "error");
        }

        $("#btnChangePass").on("click", function () {
            const pass = $("#newPass").val()?.trim();
            const confirm = $("#confirmPass").val()?.trim();

            if (!pass || !confirm) {
                showMessage("Vui lòng nhập đầy đủ thông tin.", false);
                return;
            }

            if (pass.length < 6) {
                showMessage("Mật khẩu mới phải từ 6 ký tự trở lên.", false);
                return;
            }

            if (pass !== confirm) {
                showMessage("Mật khẩu xác nhận không khớp.", false);
                return;
            }

            $.ajax({
                url: "/USER/ChangePass",
                type: "POST",
                data: {
                    pass: pass,
                    id: idTk
                },
                success: function (res) {
                    if (res && res.success) {
                        showMessage("Đổi mật khẩu thành công. Đang chuyển về trang đăng nhập...", true);
                        setTimeout(function () {
                            window.location.href = "/Home/login";
                        }, 1000);
                        return;
                    }

                    showMessage(res?.message || "Đổi mật khẩu thất bại.", false);
                },
                error: function () {
                    showMessage("Không thể kết nối máy chủ.", false);
                }
            });
        });

        const bg = document.getElementById("bgGrid");
        const rows = 10;
        const cols = 20;
        const total = rows * cols;

        for (let i = 0; i < total; i++) {
            const cell = document.createElement("div");
            cell.classList.add("cell");
            bg.appendChild(cell);
        }
    </script>
</body>
</html>
