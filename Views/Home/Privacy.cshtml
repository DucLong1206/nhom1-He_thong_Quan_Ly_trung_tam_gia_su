@{
    ViewData["Title"] = "Giới thiệu";
}

<section class="intro-section py-4 py-md-5">
    <div class="intro-panel">
        <span class="hero-badge">Về chúng tôi</span>
        <h1 class="mt-3 mb-3">LQH Eduction - Trung tâm gia sư đồng hành cùng kết quả học tập</h1>
        <p class="lead mb-3">
            LQH Eduction tập trung xây dựng hệ thống quản lý hiện đại, minh bạch và dễ vận hành
            để kết nối phụ huynh, học viên và gia sư trong một quy trình nhất quán.
        </p>
        <p class="mb-0 text-muted">
            Chúng tôi liên tục cải tiến trải nghiệm, chuẩn hóa quy trình vận hành và theo dõi chất lượng
            để mỗi lớp học đều được giám sát rõ ràng và hiệu quả.
        </p>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <article class="feature-card h-100">
                <h3>Tầm nhìn</h3>
                <p>Trở thành nền tảng quản lý trung tâm gia sư đáng tin cậy và thân thiện nhất.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="feature-card h-100">
                <h3>Sứ mệnh</h3>
                <p>Giúp trung tâm vận hành gọn, đúng luồng và nâng cao chất lượng dạy - học.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="feature-card h-100">
                <h3>Cam kết</h3>
                <p>Minh bạch dữ liệu, hỗ trợ nhanh và cải tiến liên tục dựa trên phản hồi thực tế.</p>
            </article>
        </div>
    </div>
</section>
