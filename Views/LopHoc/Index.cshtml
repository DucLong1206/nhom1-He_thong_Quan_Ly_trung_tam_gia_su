@{
    ViewData["Title"] = "Lịch đã đăng ký";
}

<style>
    .schedule-detail {
        width: 100%;
        border-top: 1px dashed #e5e7eb;
        margin-top: 10px;
        padding-top: 10px;
    }

    .buoi-item {
        font-size: 0.9rem;
        color: #374151;
        padding: 4px 0;
    }
    .schedule-wrap {
        max-width: 1050px;
        margin: 0 auto;
    }

    .schedule-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .summary-box {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        padding: 12px;
        text-align: center;
    }

    .summary-number {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
    }

    .summary-label {
        font-size: 0.82rem;
        color: #6b7280;
    }

    .schedule-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .schedule-card {
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 14px;
        padding: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .schedule-title {
        font-weight: 700;
        margin-bottom: 4px;
    }

    .schedule-meta {
        color: #4b5563;
        font-size: 0.92rem;
    }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 999px;
        text-transform: uppercase;
        height: fit-content;
    }

    .status-pending {
        color: #92400e;
        background: #fef3c7;
    }

    .status-approved {
        color: #065f46;
        background: #d1fae5;
    }

    .status-completed {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-cancelled {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 992px) {
        .summary-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 576px) {
        .summary-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="schedule-wrap">
    <div class="schedule-header">
        <h1 class="mb-0">Lịch học đã đăng ký</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-success" href="/LopHoc/LopHoc">▶ Bắt đầu buổi học OFFLINE (Demo)</a>
            <a class="btn btn-outline-primary" href="/MonHoc/Index">+ Đăng ký lịch mới</a>
        </div>
    </div>

    <div class="summary-row">
        <div class="summary-box">
            <div class="summary-number">6</div>
            <div class="summary-label">Tổng lịch đã tạo</div>
        </div>
        <div class="summary-box">
            <div class="summary-number">2</div>
            <div class="summary-label">Đang chờ duyệt</div>
        </div>
        <div class="summary-box">
            <div class="summary-number">3</div>
            <div class="summary-label">Đã duyệt</div>
        </div>
        <div class="summary-box">
            <div class="summary-number">1</div>
            <div class="summary-label">Đã hoàn thành</div>
        </div>
    </div>

    <div class="schedule-list">
        <article class="schedule-card">
            <div>
                <div class="schedule-title">Toán 8 - Gia sư Nguyễn Văn A</div>
                <div class="schedule-meta">Ngày học: 10/10/2026 • 18:00 - 19:30 • Khu vực: P. Long Bình</div>
            </div>
            <span class="status-badge status-approved">Đã duyệt</span>
        </article>

        <article class="schedule-card">
            <div>
                <div class="schedule-title">Tiếng Anh 9 - Gia sư Trần Thị B</div>
                <div class="schedule-meta">Ngày học: 12/10/2026 • 19:30 - 21:00 • Khu vực: P. Tân Phong</div>
            </div>
            <span class="status-badge status-pending">Chờ duyệt</span>
        </article>

        <article class="schedule-card">
            <div>
                <div class="schedule-title">Vật lý 10 - Gia sư Lê Văn C</div>
                <div class="schedule-meta">Ngày học: 15/10/2026 • 08:00 - 10:00 • Khu vực: P. Hố Nai</div>
            </div>
            <span class="status-badge status-completed">Đã hoàn thành</span>
        </article>

        <article class="schedule-card">
            <div>
                <div class="schedule-title">Ngữ văn 7 - Gia sư Phạm Thị D</div>
                <div class="schedule-meta">Ngày học: 16/10/2026 • 17:00 - 18:30 • Khu vực: P. Trảng Dài</div>
            </div>
            <span class="status-badge status-cancelled">Đã hủy</span>
        </article>
    </div>
</div>
@section Scripts {
<script>
    $(document).ready(function () {

        const userId = @Context.Session.GetInt32("UserId");

        $.ajax({
                url: '/LopHoc/Getlistlophocdangkiping',
            type: 'GET',
            data: { id: userId },
            success: function (res) {

                if (!res.success) {
                    alert(res.message);
                    return;
                }

                renderSchedule(res.data);
            },
            error: function () {
                alert("Lỗi gọi dữ liệu");
            }
        });

        function renderSchedule(data) {

            let html = '';
            let total = data.length;
            let pending = 0;
            let approved = 0;
            let completed = 0;

            data.forEach(item => {

                let statusClass = '';
                let statusText = '';

                        switch (item.trangThai) {

            case 1:
                statusClass = 'status-pending';
                pending++;
                break;

            case 2:
                statusClass = 'status-cancelled';
                break;

            case 3:
                statusClass = 'status-pending';
                break;

            case 4:
                statusClass = 'status-approved';
                approved++;
                break;

            case 5:
                statusClass = 'status-approved';
                approved++;
                break;

            case 6:
                statusClass = 'status-approved';
                approved++;
                break;

            case 7:
                statusClass = 'status-completed';
                completed++;
                break;

            case 8:
                statusClass = 'status-cancelled';
                break;

            default:
                statusClass = 'status-pending';
                break;
        }

                       html += `
        <article class="schedule-card" data-id="${item.id}">
            <div>
                <div class="schedule-title">
                    ${item.mon} - Gia sư ${item.name}
                </div>
                <div class="schedule-meta">
                    Bắt đầu: ${formatDate(item.ngayBatdau)}
                    • Khu vực: ${item.xa}
                </div>
            </div>

            <span class="status-badge ${statusClass}">
                ${item.trangthainame ?? "không xác định"}
            </span>

            <div class="schedule-detail" style="display:none"></div>
        </article>`;
            });

            $('.schedule-list').html(html);

            // Update summary
            $('.summary-number').eq(0).text(total);
            $('.summary-number').eq(1).text(pending);
            $('.summary-number').eq(2).text(approved);
            $('.summary-number').eq(3).text(completed);
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            return date.toLocaleDateString('vi-VN');
        }

    });
            $(document).on('click', '.schedule-card', function () {

            const card = $(this);
            const id = card.data('id');
            const detail = card.find('.schedule-detail');

            // nếu đã mở thì thu lại
            if (detail.is(':visible')) {
                detail.slideUp(200);
                return;
            }

            // nếu chưa load thì gọi API
            if (!detail.data('loaded')) {

                $.ajax({
                    url: '/LopHoc/LopHoc_Buoihocdangki_GetList_ByIDLopHoc',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {

                        if (!res.success) {
                            alert(res.message);
                            return;
                        }

                        let html = '';

                        res.data.forEach(buoi => {

                            html += `
                            <div class="buoi-item">
                                Thứ ${buoi.thu}
                                • ${formatTime(buoi.giobatdau)}
                                - ${formatTime(buoi.gioketthuc)}
                            </div>`;
                        });

                        detail.html(html);
                        detail.data('loaded', true);

                        detail.slideDown(250);
                    }
                });

            } else {
                detail.slideDown(250);
            }

        });
                function formatTime(timeString) {
            if (!timeString) return '';
            return timeString.substring(0,5);
        }
</script>
}