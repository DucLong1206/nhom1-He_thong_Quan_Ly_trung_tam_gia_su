@{
    ViewData["Title"] = "Lịch đã đăng ký";
}

<style>
    .schedule-detail {
        width: 100%;
        border-top: 1px dashed #e5e7eb;
        margin-top: 10px;
        padding-top: 10px;
    }

    .buoi-item {
        font-size: 0.9rem;
        color: #374151;
        padding: 4px 0;
    }

    .schedule-wrap {
        max-width: 1050px;
        margin: 0 auto;
    }

    .schedule-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .summary-box {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        padding: 12px;
        text-align: center;
    }

    .summary-number {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
    }

    .summary-label {
        font-size: 0.82rem;
        color: #6b7280;
    }

    .schedule-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .schedule-card {
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 14px;
        padding: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        cursor: pointer;
    }

    .schedule-title {
        font-weight: 700;
        margin-bottom: 4px;
    }

    .schedule-meta {
        color: #4b5563;
        font-size: 0.92rem;
    }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 999px;
        text-transform: uppercase;
        height: fit-content;
    }

    .status-pending {
        color: #92400e;
        background: #fef3c7;
    }

    .status-approved {
        color: #065f46;
        background: #d1fae5;
    }

    .status-completed {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-cancelled {
        color: #991b1b;
        background: #fee2e2;
    }

    .demo-start-panel {
        border: 1px solid #dbeafe;
        background: linear-gradient(180deg, #eff6ff, #ffffff);
        border-radius: 14px;
        padding: 14px;
        margin-bottom: 18px;
    }

    .demo-flow {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .demo-step {
        padding: 8px 12px;
        border-radius: 999px;
        background: #dbeafe;
        color: #1e40af;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .schedule-card-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .start-lesson-btn {
        border: none;
        border-radius: 8px;
        background: #2563eb;
        color: #fff;
        padding: 7px 10px;
        font-size: 0.82rem;
        font-weight: 600;
    }

        .start-lesson-btn:hover {
            background: #1d4ed8;
        }

    .lesson-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1040;
        padding: 12px;
    }

    .lesson-modal {
        width: min(560px, 96vw);
        border-radius: 14px;
        background: #fff;
        border: 1px solid #e5e7eb;
        padding: 16px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
    }

    .lesson-check {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: 8px 10px;
        margin-top: 8px;
        font-size: 0.9rem;
    }

    .lesson-timer {
        margin-top: 14px;
        border-radius: 10px;
        background: #f8fafc;
        padding: 10px;
        font-weight: 700;
        text-align: center;
        color: #0f172a;
    }

    @@media (max-width: 992px) {
        .summary-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 576px) {
        .summary-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="schedule-wrap">
    <div class="schedule-header">
        <h1 class="mb-0">Lịch học đã đăng ký</h1>
        <a class="btn btn-outline-primary" href="/MonHoc/Index">+ Đăng ký lịch mới</a>
    </div>

    <section class="demo-start-panel">
        <strong>Mô phỏng “Bắt đầu buổi học” (tĩnh, chưa dùng DB)</strong>
        <div class="text-muted mt-1" style="font-size:0.92rem;">
            Sau khi lớp ở trạng thái <b>Đã duyệt</b>, học viên bấm <b>Bắt đầu buổi học</b> để mở checklist trước giờ học.
        </div>
        <div class="demo-flow">
            <span class="demo-step">1. Điểm danh</span>
            <span class="demo-step">2. Xác nhận kết nối</span>
            <span class="demo-step">3. Bắt đầu bộ đếm giờ</span>
            <span class="demo-step">4. Vào phiên học</span>
        </div>
    </section>

    <div class="summary-row">
        <div class="summary-box">
            <div class="summary-number">6</div>
            <div class="summary-label">Tổng lịch đã tạo</div>
        </div>
        <div class="summary-box">
            <div class="summary-number">2</div>
            <div class="summary-label">Đang chờ duyệt</div>
        </div>
        <div class="summary-box">
            <div class="summary-number">3</div>
            <div class="summary-label">Đã duyệt</div>
        </div>
        <div class="summary-box">
            <div class="summary-number">1</div>
            <div class="summary-label">Đã hoàn thành</div>
        </div>
    </div>

    <div class="schedule-list">
        <article class="schedule-card">
            <div>
                <div class="schedule-title">Toán 8 - Gia sư Nguyễn Văn A</div>
                <div class="schedule-meta">Ngày học: 10/10/2026 • 18:00 - 19:30 • Khu vực: P. Long Bình</div>
            </div>
            <div class="schedule-card-actions">
                <button class="start-lesson-btn" type="button" data-title="Toán 8 - Gia sư Nguyễn Văn A">Bắt đầu buổi học</button>
                <span class="status-badge status-approved">Đã duyệt</span>
            </div>
        </article>
    </div>
</div>

<div class="lesson-modal-backdrop" id="lessonModal">
    <div class="lesson-modal">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="fw-bold">Bắt đầu buổi học (Demo)</div>
                <div class="text-muted" id="lessonTitle" style="font-size:0.9rem;">Toán 8 - Gia sư Nguyễn Văn A</div>
            </div>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="closeLessonModal">Đóng</button>
        </div>

        <div class="lesson-check"><span>Điểm danh học viên</span><span>✅</span></div>
        <div class="lesson-check"><span>Kiểm tra camera/mic</span><span>✅</span></div>
        <div class="lesson-check"><span>Tài liệu buổi học</span><span>✅</span></div>

        <div class="lesson-timer">00:00:00</div>

        <div class="d-flex justify-content-end mt-3 gap-2">
            <button class="btn btn-outline-secondary" type="button" id="cancelLessonStart">Hủy</button>
            <button class="btn btn-primary" type="button" id="confirmLessonStart">Xác nhận bắt đầu</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {

        const userId = @Context.Session.GetInt32("UserId");

        $.ajax({
            url: '/LopHoc/Getlistlophocdangkiping',
            type: 'GET',
            data: { id: userId },
            success: function (res) {

                if (!res.success) {
                    alert(res.message);
                    return;
                }

                renderSchedule(res.data);
            },
            error: function () {
                alert("Lỗi gọi dữ liệu");
            }
        });

        function renderSchedule(data) {

            let html = '';
            let total = data.length;
            let pending = 0;
            let approved = 0;
            let completed = 0;

            data.forEach(item => {

                let statusClass = '';
                const canStartLesson = [4, 5, 6].includes(item.trangThai);

                switch (item.trangThai) {
                    case 1:
                        statusClass = 'status-pending';
                        pending++;
                        break;
                    case 2:
                        statusClass = 'status-cancelled';
                        break;
                    case 3:
                        statusClass = 'status-pending';
                        break;
                    case 4:
                    case 5:
                    case 6:
                        statusClass = 'status-approved';
                        approved++;
                        break;
                    case 7:
                        statusClass = 'status-completed';
                        completed++;
                        break;
                    case 8:
                        statusClass = 'status-cancelled';
                        break;
                    default:
                        statusClass = 'status-pending';
                        break;
                }

                html += `
                <article class="schedule-card" data-id="${item.id}">
                    <div>
                        <div class="schedule-title">${item.mon} - Gia sư ${item.name}</div>
                        <div class="schedule-meta">Bắt đầu: ${formatDate(item.ngayBatdau)} • Khu vực: ${item.xa}</div>
                    </div>

                    <div class="schedule-card-actions">
                        ${canStartLesson ? `<button class="start-lesson-btn" type="button" data-title="${item.mon} - Gia sư ${item.name}">Bắt đầu buổi học</button>` : ''}
                        <span class="status-badge ${statusClass}">${item.trangthainame ?? "không xác định"}</span>
                    </div>

                    <div class="schedule-detail" style="display:none"></div>
                </article>`;
            });

            $('.schedule-list').html(html);

            $('.summary-number').eq(0).text(total);
            $('.summary-number').eq(1).text(pending);
            $('.summary-number').eq(2).text(approved);
            $('.summary-number').eq(3).text(completed);
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            return date.toLocaleDateString('vi-VN');
        }

        $(document).on('click', '.start-lesson-btn', function (e) {
            e.stopPropagation();
            const title = $(this).data('title') || 'Buổi học';
            $('#lessonTitle').text(title);
            $('#lessonModal').css('display', 'flex');
        });

        $('#closeLessonModal, #cancelLessonStart').on('click', function () {
            $('#lessonModal').hide();
        });

        $('#confirmLessonStart').on('click', function () {
            Swal.fire({
                icon: 'success',
                title: 'Đã bắt đầu buổi học (demo)',
                text: 'Hiện tại chỉ là mô phỏng tĩnh, chưa ghi DB.',
                confirmButtonText: 'OK'
            });
            $('#lessonModal').hide();
        });

        $(document).on('click', '.schedule-card', function () {

            const card = $(this);
            const id = card.data('id');
            const detail = card.find('.schedule-detail');

            if (detail.is(':visible')) {
                detail.slideUp(200);
                return;
            }

            if (!detail.data('loaded')) {

                $.ajax({
                    url: '/LopHoc/LopHoc_Buoihocdangki_GetList_ByIDLopHoc',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {

                        if (!res.success) {
                            alert(res.message);
                            return;
                        }

                        let html = '';

                        res.data.forEach(buoi => {
                            html += `<div class="buoi-item">Thứ ${buoi.thu} • ${formatTime(buoi.giobatdau)} - ${formatTime(buoi.gioketthuc)}</div>`;
                        });

                        detail.html(html);
                        detail.data('loaded', true);
                        detail.slideDown(250);
                    }
                });

            } else {
                detail.slideDown(250);
            }

        });

        function formatTime(timeString) {
            if (!timeString) return '';
            return timeString.substring(0, 5);
        }
    });
</script>
}
