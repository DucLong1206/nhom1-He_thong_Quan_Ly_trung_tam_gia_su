@{
    ViewData["Title"] = "Chi tiết lịch học";
    var data = ViewBag.data;
    var lop = data?.lop;
    var dsBuoi = data?.dsBuoi;
    var nguoigui = data?.nguoiGui;
    var tenmon = data?.tenmon;
}

<div class="container py-4">

    <div class="card shadow-lg border-0">
        <div class="card-body p-4">

            <h4 class="mb-3">📚 Chi tiết lớp học</h4>

            <hr />

            <div class="row">

                <div class="col-md-6">

                    <p>
                        <b>Môn học:</b>
                        <span class="text-primary">Môn @tenmon - lớp @lop?.trinhdo</span>
                    </p>
                    <p>
                        <b>Học viên:</b> @nguoigui?.Name
                    </p>


                </div>

                <div class="col-md-6">
                    <p>
                        <b>Địa điểm:</b>
                        @lop?.DIaChi
                    </p>

                    <p>
                        <b>Trạng thái:</b>

                        @switch (lop?.TrangThai)
                        {
                            case 1:
                                <span class="badge bg-warning text-dark">Mới tạo</span>
                                break;

                            case 2:
                                <span class="badge bg-success">Đã chấp nhận</span>
                                break;

                            case 3:
                                <span class="badge bg-primary">Đang diễn ra</span>
                                break;

                            case 4:
                                <span class="badge bg-success">Hoàn thành</span>
                                break;

                            case 5:
                                <span class="badge bg-danger">Đã hủy</span>
                                break;

                            default:
                                <span class="badge bg-secondary">Không xác định</span>
                                break;
                        }

                    </p>

                </div>

            </div>

            <hr />

            <h5 class="mb-3">📅 Lịch học</h5>

            <div class="list-group" id="scheduleList">

                @if (dsBuoi != null)
                {
                    foreach (var b in dsBuoi)
                    {
                        <div class="list-group-item schedule-item" data-thu="@b.thu">
                            <div class="d-flex justify-content-between align-items-center">
                                <b>
                                    @{
                                        string thu = b.thu switch
                                        {
                                            2 => "Thứ 2",
                                            3 => "Thứ 3",
                                            4 => "Thứ 4",
                                            5 => "Thứ 5",
                                            6 => "Thứ 6",
                                            7 => "Thứ 7",
                                            8 => "Chủ nhật",
                                            _ => ""
                                        };
                                    }
                                    @thu
                                </b>

                                <span class="badge bg-light text-dark schedule-view-time">
                                    @b.giobatdau.ToString().Substring(0, 5)-@b.gioketthuc.ToString().Substring(0, 5)
                                </span>
                            </div>

                            <div class="row g-2 mt-2 schedule-edit d-none">
                                <div class="col-md-6">
                                    <label class="form-label mb-1">Giờ bắt đầu</label>
                                    <input type="time" class="form-control start-time" value="@b.giobatdau.ToString().Substring(0, 5)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label mb-1">Giờ kết thúc</label>
                                    <input type="time" class="form-control end-time" value="@b.gioketthuc.ToString().Substring(0, 5)" />
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>

            <hr />

            <div class="d-flex gap-2 mt-3 flex-wrap">

                <button id="btnAccept" class="btn btn-success">
                    ✔ Ký hợp đồng
                </button>

                <button id="btnReject" class="btn btn-danger">
                    ✖ Từ chối
                </button>

                <button id="btnEdit" class="btn btn-warning">
                    ✏ Điều chỉnh
                </button>

                <button id="btnSendAdjust" class="btn btn-primary d-none">
                    📤 Gửi điều chỉnh
                </button>

            </div>

            <div id="rejectBlock" class="mt-3 d-none">
                <label for="rejectReason" class="form-label"><b>Lý do không đồng ý</b></label>
                <textarea id="rejectReason" class="form-control" rows="3" placeholder="Nhập lý do..."></textarea>
                <button id="btnSendReject" class="btn btn-danger mt-2">Gửi từ chối</button>
            </div>

            <div id="actionMessage" class="alert mt-3 d-none"></div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        const lopId = @lop?.id;

        $(document).ready(function () {
            $("#btnAccept").on("click", function () {
                window.location.href = "/LopHoc/Contract?lopId=" + lopId;
            });

            $("#btnReject").on("click", function () {
                $("#rejectBlock").removeClass("d-none");
                $("#actionMessage").addClass("d-none");
            });

            $("#btnSendReject").on("click", function () {
                const reason = $("#rejectReason").val().trim();

                if (!reason) {
                    showMessage("Vui lòng nhập lý do từ chối.", false);
                    return;
                }

                const payload = {
                    lopId: lopId,
                    action: "reject",
                    reason: reason,
                    schedule: []
                };

                sendResponse(payload, "Đã gửi từ chối kèm lý do và lớp id.");
            });

            $("#btnEdit").on("click", function () {
                $(".schedule-edit").removeClass("d-none");
                $("#btnSendAdjust").removeClass("d-none");
                $("#actionMessage").addClass("d-none");
            });

            $("#btnSendAdjust").on("click", function () {
                const schedule = [];
                let invalid = false;

                $(".schedule-item").each(function () {
                    const thu = parseInt($(this).data("thu"));
                    const gioBatDau = $(this).find(".start-time").val();
                    const gioKetThuc = $(this).find(".end-time").val();

                    if (!gioBatDau || !gioKetThuc || gioBatDau >= gioKetThuc) {
                        invalid = true;
                    }

                    schedule.push({
                        thu: thu,
                        gioBatDau: gioBatDau,
                        gioKetThuc: gioKetThuc
                    });
                });

                if (invalid) {
                    showMessage("Vui lòng kiểm tra lại giờ bắt đầu/kết thúc.", false);
                    return;
                }

                const payload = {
                    lopId: lopId,
                    action: "adjust",
                    reason: null,
                    schedule: schedule
                };

                sendResponse(payload, "Đã gửi điều chỉnh lịch kèm lớp id.");
            });
        });

        function sendResponse(payload, successMessage) {
            $.ajax({
                url: "/LopHoc/XuLyPhanHoi",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        showMessage(`${successMessage} (Lớp ID: ${res.lopId})`, true);
                    } else {
                        showMessage(res.message || "Gửi thất bại.", false);
                    }
                },
                error: function () {
                    showMessage("Có lỗi khi gửi dữ liệu.", false);
                }
            });
        }

        function showMessage(message, isSuccess) {
            const box = $("#actionMessage");
            box.removeClass("d-none alert-success alert-danger");
            box.addClass(isSuccess ? "alert-success" : "alert-danger");
            box.text(message);
        }
    </script>
}
