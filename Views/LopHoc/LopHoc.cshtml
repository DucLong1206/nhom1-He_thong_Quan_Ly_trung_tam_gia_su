@{
    ViewData["Title"] = "Bắt đầu buổi học";
}

<style>
    .start-lesson-wrap {
        max-width: 900px;
        margin: 0 auto;
    }

    .start-lesson-card {
        border: 1px solid #dbeafe;
        background: linear-gradient(180deg, #eff6ff, #ffffff);
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 16px;
    }

    .flow-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 12px;
    }

    .flow-step {
        background: #dbeafe;
        color: #1e40af;
        border-radius: 999px;
        font-size: 0.84rem;
        font-weight: 600;
        padding: 8px 12px;
    }

    .lesson-box {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 14px;
        background: #fff;
    }

    .lesson-check {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: 8px 10px;
        margin-top: 8px;
    }

    .timer-box {
        margin-top: 12px;
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px;
        text-align: center;
        font-weight: 700;
    }
</style>

<div class="start-lesson-wrap">
    <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
        <h2 class="mb-0">Bắt đầu buổi học (Demo tĩnh)</h2>
        <a class="btn btn-outline-secondary" href="/LopHoc/Index">← Quay lại lịch học</a>
    </div>

    <section class="start-lesson-card">
        <div class="fw-bold">Luồng bắt đầu buổi học</div>
        <div class="text-muted" style="font-size:0.92rem;">Không dùng DB, chỉ mô phỏng UI để chốt flow trước khi nối backend.</div>
        <div class="flow-row">
            <span class="flow-step">1. Điểm danh</span>
            <span class="flow-step">2. Kiểm tra camera/mic</span>
            <span class="flow-step">3. Xác nhận tài liệu</span>
            <span class="flow-step">4. Bắt đầu phiên học</span>
        </div>
    </section>

    <section class="lesson-box">
        <div class="fw-bold">Lớp: Toán 8 - Gia sư Nguyễn Văn A</div>
        <div class="text-muted" style="font-size:0.92rem;">Thời gian: 18:00 - 19:30 • Khu vực: P. Long Bình</div>

        <div class="lesson-check"><span>Điểm danh học viên</span><span>✅</span></div>
        <div class="lesson-check"><span>Kiểm tra camera/mic</span><span>✅</span></div>
        <div class="lesson-check"><span>Tài liệu buổi học</span><span>✅</span></div>

        <div class="timer-box">00:00:00</div>

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" id="btnStartLesson" type="button">Xác nhận bắt đầu</button>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(document).on('click', '#btnStartLesson', function () {
            Swal.fire({
                icon: 'success',
                title: 'Đã bắt đầu buổi học (demo)',
                text: 'Đây là giao diện tĩnh, chưa lưu dữ liệu xuống DB.',
                confirmButtonText: 'OK'
            });
        });
    </script>
}
