@{
    ViewData["Title"] = "Bắt đầu buổi học";
}

<style>
    .start-lesson-wrap {
        max-width: 900px;
        margin: 0 auto;
    }

    .start-lesson-card {
        border: 1px solid #dbeafe;
        background: linear-gradient(180deg, #eff6ff, #ffffff);
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 16px;
    }

    .flow-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 12px;
    }

    .flow-step {
        background: #dbeafe;
        color: #1e40af;
        border-radius: 999px;
        font-size: 0.84rem;
        font-weight: 600;
        padding: 8px 12px;
    }

    .lesson-box {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 14px;
        background: #fff;
    }

    .lesson-check {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: 8px 10px;
        margin-top: 8px;
    }

    .timer-box {
        margin-top: 12px;
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px;
        text-align: center;
        font-weight: 700;
    }
</style>

<div class="start-lesson-wrap">
    <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
        <h2 class="mb-0">Bắt đầu buổi học OFFLINE (Demo tĩnh)</h2>
        <a class="btn btn-outline-secondary" href="/LopHoc/Index">← Quay lại lịch học</a>
    </div>

    <section class="start-lesson-card">
        <div class="fw-bold">Luồng bắt đầu buổi học trực tiếp (OFFLINE)</div>
        <div class="text-muted" style="font-size:0.92rem;">Không dùng DB, ưu tiên mô phỏng lớp học trực tiếp trước; phần online sẽ làm sau.</div>
        <div class="flow-row">
            <span class="flow-step">1. Điểm danh</span>
            <span class="flow-step">2. Check-in tại địa điểm học</span>
            <span class="flow-step">3. Ổn định chỗ ngồi & tài liệu</span>
            <span class="flow-step">4. Bắt đầu buổi học</span>
        </div>
    </section>

    <section class="lesson-box">
        <div class="fw-bold">Lớp: Toán 8 - Gia sư Nguyễn Văn A</div>
        <div class="text-muted" style="font-size:0.92rem;">Thời gian: 18:00 - 19:30 • Địa điểm: P. Long Bình (học trực tiếp)</div>

        <div class="lesson-check"><span>Điểm danh học viên</span><span>✅</span></div>
        <div class="lesson-check"><span>Xác nhận có mặt phụ huynh/học viên</span><span>✅</span></div>
        <div class="lesson-check"><span>Dụng cụ học tập đầy đủ</span><span>✅</span></div>

        <div class="timer-box">00:00:00</div>

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" id="btnStartLesson" type="button">Xác nhận bắt đầu OFFLINE</button>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(document).on('click', '#btnStartLesson', function () {
            Swal.fire({
                icon: 'success',
                title: 'Đã bắt đầu buổi học OFFLINE (demo)',
                text: 'Luồng offline đã sẵn sàng (tĩnh), phần online sẽ bổ sung sau.',
                confirmButtonText: 'OK'
            });
        });
    </script>
}
