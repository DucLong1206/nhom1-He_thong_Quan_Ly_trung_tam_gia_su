@{
    ViewData["Title"] = "Chi tiết gia sư";

    var tutorName = ViewData["TutorName"] as string ?? "Gia sư mẫu";
    var mon = ViewData["Mon"] as string ?? "Đang cập nhật";
    var xa = ViewData["Xa"] as string ?? "Đang cập nhật";
    var giaTheoGio = ViewData["GiaTheoGio"] as decimal? ?? 120000;
}

<style>
    .detail-wrap {
        max-width: 980px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 20px;
    }

    .detail-card {
        background: #fff;
        border: 1px solid #eceff4;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    }

    .detail-head {
        display: flex;
        gap: 16px;
        align-items: center;
        margin-bottom: 16px;
    }

    .detail-avatar {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #6c63ff, #48cfad);
    }

    .meta-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 12px;
    }

    .meta-box {
        border: 1px solid #e7eaf3;
        border-radius: 12px;
        padding: 12px;
        text-align: center;
        background: #f9fafc;
    }

    .meta-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #374151;
    }

    .meta-label {
        font-size: 0.8rem;
        color: #6b7280;
    }

    .comment-item {
        padding: 10px 0;
        border-bottom: 1px dashed #e5e7eb;
    }

    .comment-item:last-child {
        border-bottom: none;
    }

    .booking-form .form-control,
    .booking-form .form-select {
        border-radius: 10px;
    }

    @@media (max-width: 992px) {
        .detail-wrap {
            grid-template-columns: 1fr;
        }

        .meta-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<h1 class="mb-4">Chi tiết gia sư</h1>

<div class="detail-wrap">
    <section class="detail-card">
        <div class="detail-head">
            <div class="detail-avatar" id="avatarName"></div>
            <div>
                <h3 class="mb-1" id="tutorName">@tutorName</h3>
                <div class="text-muted" id="monHoc">Môn: @mon</div>
                <div class="text-muted" id="khuVuc">Khu vực: @xa</div>
                <div class="fw-bold text-success mt-1" id="hocPhi">@giaTheoGio.ToString("N0") VNĐ / giờ</div>
            </div>
        </div>

        <p class="mb-2"><strong>Giới thiệu:</strong> Gia sư có kinh nghiệm dạy kèm 1-1, hỗ trợ lộ trình học theo năng lực học sinh và cập nhật kết quả mỗi buổi.</p>

        <div class="meta-grid">
            <div class="meta-box">
                <div class="meta-value" id="soMon">3</div>
                <div class="meta-label">Số môn đang dạy</div>
            </div>
            <div class="meta-box">
                <div class="meta-value" id="soHocSinh">18</div>
                <div class="meta-label">Học sinh đã đăng ký</div>
            </div>
            <div class="meta-box">
                <div class="meta-value" id="danhGia">4.8/5</div>
                <div class="meta-label">Đánh giá trung bình</div>
            </div>
        </div>

        <h5 class="mt-4">Bình luận gần đây</h5>
        <div id="commentList"></div>
    </section>

    <aside class="detail-card">
        <h5 class="mb-3">Đặt lịch học</h5>
        <form class="booking-form">
            <div class="mb-3">
                <label class="form-label">Họ tên học sinh</label>
                <input class="form-control" placeholder="Nhập họ tên" />
            </div>
            <div class="mb-3">
                <label class="form-label">Môn học</label>
                <select class="form-select">
                    <option>@mon</option>
                    <option>Toán</option>
                    <option>Văn</option>
                    <option>Anh</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Ngày học</label>
                <input type="date" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Khung giờ</label>
                <select class="form-select">
                    <option>18:00 - 19:30</option>
                    <option>19:30 - 21:00</option>
                    <option>Thứ 7, 08:00 - 10:00</option>
                </select>
            </div>

            <button type="button" class="btn btn-primary w-100">Gửi yêu cầu đặt lịch (demo)</button>
            <a href="/MonHoc/LichDaDangKy" class="btn btn-outline-secondary w-100 mt-2">Xem các lịch đã đăng ký</a>
        </form>
    </aside>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const name = "@tutorName";
        const initials = name
            .split(" ")
            .filter(Boolean)
            .map((word, index, arr) => index === 0 || index === arr.length - 1 ? word[0] : "")
            .join("")
            .slice(0, 2)
            .toUpperCase();

        document.getElementById("avatarName").textContent = initials || "GS";

        const staticStatsByTutor = {
            "Nguyễn Văn A": { soMon: 2, soHocSinh: 14, danhGia: "4.7/5" },
            "Trần Thị B": { soMon: 4, soHocSinh: 23, danhGia: "4.9/5" }
        };

        const commentsByTutor = {
            "Nguyễn Văn A": [
                { ten: "Phụ huynh bé Minh", noiDung: "Gia sư dạy kỹ, con dễ hiểu bài hơn sau 2 tuần." },
                { ten: "Phụ huynh bé An", noiDung: "Đúng giờ, có báo cáo tiến độ sau mỗi buổi." }
            ],
            default: [
                { ten: "Phụ huynh lớp 8", noiDung: "Gia sư nhiệt tình, hỗ trợ cả bài tập về nhà." },
                { ten: "Học viên THPT", noiDung: "Giải thích dễ hiểu, giúp em tự tin hơn khi kiểm tra." }
            ]
        };

        const stats = staticStatsByTutor[name] || { soMon: 3, soHocSinh: 18, danhGia: "4.8/5" };
        document.getElementById("soMon").textContent = stats.soMon;
        document.getElementById("soHocSinh").textContent = stats.soHocSinh;
        document.getElementById("danhGia").textContent = stats.danhGia;

        const comments = commentsByTutor[name] || commentsByTutor.default;
        const commentContainer = document.getElementById("commentList");
        commentContainer.innerHTML = comments
            .map(c => `<div class="comment-item"><strong>${c.ten}:</strong> ${c.noiDung}</div>`)
            .join("");
    });
</script>
