
@{
    ViewData["Title"] = "Danh sách môn học";
}

<style>
    .gs-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .gs-card {
        display: flex;
        align-items: center;
        background: #ffffff;
        border: 1px solid #e8e8f0;
        border-radius: 16px;
        padding: 16px 20px;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }

        .gs-card::after {
            content: '';
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: 2px 0 0 2px;
            background: var(--stripe, #6c63ff);
        }

        .gs-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(0,0,0,0.10);
        }

    .gs-avatar {
        width: 62px;
        height: 62px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--grad1, #6c63ff), var(--grad2, #48cfad));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
    }

    .gs-divider {
        width: 1px;
        height: 50px;
        background: #e8e8f0;
        margin: 0 18px;
    }

    .gs-info {
        flex: 1;
    }

    .gs-name {
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 5px;
    }

    .gs-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }

    .gs-tag {
        font-size: 0.68rem;
        font-weight: 600;
        padding: 2px 9px;
        border-radius: 20px;
        text-transform: uppercase;
    }

        .gs-tag.subject {
            background: rgba(108,99,255,0.1);
            color: #6c63ff;
        }

        .gs-tag.area {
            background: rgba(255,159,67,0.1);
            color: #d97706;
        }

    .gs-price {
        font-size: 1rem;
        font-weight: 700;
        color: #059669;
    }

    .gs-empty {
        text-align: center;
        padding: 40px;
        color: #9ca3af;
        font-style: italic;
    }
</style>

<h1 class="mb-3">Danh sách môn học & gia sư</h1>

<form id="filterForm" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Từ khóa</label>
        <input class="form-control" name="keyword" placeholder="Ví dụ: Toán, Nguyễn Văn A" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Môn học</label>
        <select class="form-select" name="monHocId">
            <option value="">-- Tất cả --</option>
            @foreach (var opt in Model.MonHocOptions)
            {
                <option value="@opt.Value">@opt.Text</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Khu vực</label>
        <select class="form-select" name="xaId">
            <option value="">-- Tất cả --</option>
            @foreach (var opt in Model.XaOptions)
            {
                <option value="@opt.Value">@opt.Text</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Sắp xếp</label>
        <select class="form-select" name="sort">
            <option value="name_asc">Tên A-Z</option>
            <option value="name_desc">Tên Z-A</option>
            <option value="price_asc">Giá tăng dần</option>
            <option value="price_desc">Giá giảm dần</option>
        </select>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<div class="gs-list">
    <div class="gs-empty">Đang tải dữ liệu...</div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        loadData();

        document.getElementById("filterForm").addEventListener("submit", function (e) {
            e.preventDefault();
            loadData();
        });

        function loadData() {

            const formData = new FormData(document.getElementById("filterForm"));
            const queryString = new URLSearchParams(formData).toString();

            fetch("/GiaSu/getlist?" + queryString) // đổi đúng controller nếu khác
                .then(res => res.json())
                .then(res => renderList(res.data))
                .catch(err => console.error(err));
        }

        function renderList(data) {

            const container = document.querySelector(".gs-list");
            container.innerHTML = "";

            if (!data || data.length === 0) {
                container.innerHTML = `<div class="gs-empty">Không có dữ liệu phù hợp.</div>`;
                return;
            }

            data.forEach(item => {

                let initials = "GS";
                if (item.tenGiaSu) {
                    let parts = item.tenGiaSu.trim().split(" ");
                    if (parts.length >= 2)
                        initials = parts[0][0] + parts[parts.length - 1][0];
                    else if (item.tenGiaSu.length >= 2)
                        initials = item.tenGiaSu.substring(0, 2);
                }

                const html = `
                <div class="gs-card">
                    <div class="gs-avatar">${initials.toUpperCase()}</div>
                    <div class="gs-divider"></div>
                    <div class="gs-info">
                        <div class="gs-name">${item.tenGiaSu ?? ""}</div>
                        <div class="gs-tags">
                            <span class="gs-tag subject">${item.tenMon ?? ""}</span>
                            <span class="gs-tag area">${item.tenXa ?? ""}</span>
                        </div>
                        <div class="gs-price">
                            ${Number(item.giaTheoGio).toLocaleString()} VNĐ / giờ
                        </div>
                    </div>
                </div>`;

                container.insertAdjacentHTML("beforeend", html);
            });
        }
    });
</script>